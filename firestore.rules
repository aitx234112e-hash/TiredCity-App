rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
//  TiredCity — Firestore Security Rules
//
//  BỐI CẢNH: App khách đăng nhập OFFLINE (không dùng Firebase Auth) nên khi ghi
//  đơn hàng, request.auth == null. Với rule mặc định "khoá hết", thao tác này bị
//  chặn → lỗi "PERMISSION_DENIED: Missing or insufficient permissions".
//
//  Bộ rule dưới đây cho phép app khách TẠO đơn (create) mà không cần đăng nhập,
//  nhưng vẫn khoá đọc/sửa/xoá đơn và mọi dữ liệu nhạy cảm cho admin đã đăng nhập.
//
//  ⚠️ "allow create: if true" nghĩa là bất kỳ ai cũng tạo được document đơn hàng.
//     Chấp nhận được cho demo. Muốn siết chặt → xem mục "Phương án bảo mật hơn"
//     trong hướng dẫn (bật Anonymous Auth và đổi thành: if request.auth != null).
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Sản phẩm: ai cũng đọc, chỉ admin (đã đăng nhập) mới ghi
    match /products/{id} {
    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email.endsWith('@tiredcity.com')
      );
    }

    function isOwner(data) {
      return isSignedIn() && (request.auth.uid == data.userId || request.auth.uid == data.user);
    }

    // --- COLLECTION RULES ---

    // Products: Ai cũng có thể đọc, chỉ admin mới được sửa
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
      allow write: if isAdmin();
    }

    // Cấu hình vận chuyển: app khách cần đọc để hiện gói ship
    match /shipping_settings/{id} {
    // Orders:
    // - Khách hàng chỉ được xem đơn của mình (kiểm tra cả userId và user field)
    // - Khách hàng được tạo đơn (với status mặc định là PENDING)
    // - Chỉ Admin mới được sửa trạng thái (status)
    match /orders/{orderId} {
      allow read: if isSignedIn() && (isOwner(resource.data) || isAdmin());

      allow create: if isSignedIn()
        && (request.resource.data.userId == request.auth.uid || request.resource.data.user == request.auth.uid)
        && request.resource.data.status == 'PENDING';

      allow update: if isAdmin()
        || (isOwner(resource.data) && resource.data.status == 'PENDING' && request.resource.data.status == 'CANCELLED');

      allow delete: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }

    // Shipping Configs
    match /shipping_configs/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /shipping_configs/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Đơn hàng: app khách TẠO đơn (không cần auth, có kiểm tra field tối thiểu);
    // đọc/sửa/xoá dành cho admin đã đăng nhập.
    match /orders/{id} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.totalPrice is number
                    && request.resource.data.totalPrice >= 0;
      allow read, update, delete: if request.auth != null;
      allow write: if isAdmin();
    }

    // Default
    match /{path=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    // Người dùng & nhật ký kiểm toán: chỉ admin
    match /users/{id} {
      allow read, write: if request.auth != null;
    }
    match /auditLogs/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
