// TiredCity Admin — Prisma schema
// Truc chinh: Product -> ProductVariant -> OrderItem <- Order
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========================= AUTH / RBAC (A1, A5) =========================
model User {
  id        String    @id @default(uuid())
  googleId  String?   @unique @map("google_id")
  email     String    @unique
  fullName  String?   @map("full_name")
  phone     String?
  address   String?
  avatarUrl String?   @map("avatar_url")
  birthDate DateTime? @map("birth_date")
  zodiac    String?
  points    Int       @default(0)
  role      String    @default("CUSTOMER") // Role: CUSTOMER, STAFF, ADMIN, AUDITOR
  menh      String? // Menh: KIM, MOC, THUY, HOA, THO
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  orders    Order[]
  menhCards MenhCard[]
  auditLogs AuditLog[]
  reviews   Review[]

  @@map("users")
}

// ========================= SHIPPING (A3) =========================
model ShippingMethod {
  id            String   @id @default(uuid())
  name          String
  fee           Float
  estimatedTime String?  @map("estimated_time") // vd "2-3 ngay"
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("shipping_methods")
}

// ========================= PRODUCT (A4) =========================
model Collection {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  bannerUrl   String?   @map("banner_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("collections")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  culturalStory String?  @map("cultural_story") // dac thu TiredCity
  basePrice     Float    @map("base_price")
  salePrice     Float?   @map("sale_price")
  material      String?
  menh          String? // Menh: KIM, MOC, THUY, HOA, THO
  status        String   @default("DRAFT") // ProductStatus: DRAFT, ACTIVE, SOLD_OUT, ARCHIVED
  collectionId  String?  @map("collection_id")
  categoryId    String?  @map("category_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  collection Collection?      @relation(fields: [collectionId], references: [id])
  category   Category?        @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  reviews    Review[]

  @@index([status])
  @@index([collectionId])
  @@map("products")
}

model ProductVariant {
  id        String @id @default(uuid())
  productId String @map("product_id")
  color     String
  size      String // Size: S, M, L, XL, XXL, FREE
  sku       String @unique
  price     Float
  stockQty  Int    @default(0) @map("stock_qty")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, color, size])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  url       String
  publicId  String? @map("public_id") // cloudinary public_id de xoa
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ========================= REVIEW (A10) =========================
model Review {
  id            String    @id @default(uuid())
  productId     String    @map("product_id")
  userId        String    @map("user_id")
  userName      String?   @map("user_name")
  userAvatarUrl String?   @map("user_avatar_url")
  rating        Float
  comment       String?
  status        String    @default("PENDING") // PENDING, APPROVED, HIDDEN
  adminReply    String?   @map("admin_reply")
  repliedAt     DateTime? @map("replied_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@map("reviews")
}

// ========================= ORDER (A3) =========================
model Order {
  id              String   @id @default(uuid())
  orderCode       String   @unique @map("order_code")
  userId          String   @map("user_id")
  status          String   @default("PENDING") // OrderStatus: PENDING, CONFIRMED, PACKING, SHIPPING, DELIVERED, CANCELLED, REFUNDED
  subtotal        Float
  discount        Float    @default(0)
  shippingFee     Float    @default(0) @map("shipping_fee")
  total           Float
  recipientName   String?  @map("recipient_name")
  recipientPhone  String?  @map("recipient_phone")
  shippingAddress String?  @map("shipping_address")
  voucherId       String?  @map("voucher_id")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id])
  voucher Voucher?    @relation(fields: [voucherId], references: [id])
  items   OrderItem[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String @map("order_id")
  variantId   String @map("variant_id")
  productName String @map("product_name") // snapshot phong khi SP doi ten/xoa
  variantInfo String @map("variant_info") // vd "Do - size M"
  unitPrice   Float  @map("unit_price")
  quantity    Int
  lineTotal   Float  @map("line_total")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

// ========================= VOUCHER (A6) =========================
model Voucher {
  id          String    @id @default(uuid())
  code        String    @unique
  type        String // VoucherType: PERCENT, FIXED
  value       Float
  minOrder    Float     @default(0) @map("min_order")
  maxDiscount Float?    @map("max_discount")
  usageLimit  Int?      @map("usage_limit")
  usedCount   Int       @default(0) @map("used_count")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  isActive    Boolean   @default(true) @map("is_active")
  orders      Order[]

  @@map("vouchers")
}

// ========================= MENH CARD (dac thu TiredCity) =========================
model MenhCard {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  menh         String // Menh: KIM, MOC, THUY, HOA, THO
  cardImageUrl String?   @map("card_image_url")
  message      String?
  status       String    @default("PENDING") // PENDING | SENT
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("menh_cards")
}

// ========================= AUDIT LOG (A9) =========================
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   String? // SQLite doesn't support Json, using String to store serialized JSON
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}
