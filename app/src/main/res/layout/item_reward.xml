<?xml version="1.0" encoding="utf-8"?>
<!-- Voucher: nền trắng mờ, viền gần như không thấy -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_reward_card"
    android:foreground="?attr/selectableItemBackground"
    android:padding="12dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="24dp">

    <!-- Banner ngang: hiện trọn ảnh vì chữ ưu đãi nằm trong ảnh -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_reward_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.TC.Medium"
        tools:src="@drawable/reward_birthday" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_reward_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        tools:text="Birthday TO YOU" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_reward_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="Voucher tri ân sinh nhật · Giảm 10% BST Nhật Bình" />

    <!-- Hiệu lực + nút Sử dụng ngay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="14dp">

        <TextView
            android:id="@+id/tv_reward_validity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="01/07/2026 - 31/07/2026" />

        <Button
            android:id="@+id/btn_use_now"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/tc_btn_red_md"
            android:paddingHorizontal="22dp"
            android:text="@string/reward_use_now"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
    </LinearLayout>
</LinearLayout>
