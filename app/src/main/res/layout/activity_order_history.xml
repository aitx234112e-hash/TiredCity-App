<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- ── Header đỏ: back + logo gà trống + thông báo (bỏ banner wordmark TIREDCITY). ── -->
    <LinearLayout
        android:id="@+id/header_red"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/tc_red"
        android:paddingStart="6dp"
        android:paddingEnd="@dimen/tc_space_sm"
        android:paddingTop="18dp"
        android:paddingBottom="@dimen/tc_space_lg">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/tc_on_red"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/nav_back" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tc_logo"
            app:tint="@color/tc_on_red"
            android:contentDescription="@string/app_name" />

        <FrameLayout
            android:id="@+id/btn_notification"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_notifications">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bell"
                app:tint="@color/tc_on_red"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_notif_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:minWidth="17dp"
                android:minHeight="17dp"
                android:paddingHorizontal="4dp"
                android:gravity="center"
                android:background="@drawable/tc_badge_count_on_red"
                android:textColor="@color/tc_espresso"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="56"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <!-- ── Tiêu đề + tab lọc trạng thái: nền đen, chữ trắng, gạch chân đỏ + ripple khi nhấn —
         cùng bản sắc với tab nhóm trang phục ở màn Danh mục (fragment_styling.xml). ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/tc_noir">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/order_history_title"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:paddingHorizontal="@dimen/tc_space_xl"
            android:paddingTop="@dimen/tc_space_lg"
            android:paddingBottom="@dimen/tc_space_md" />

        <!-- Status filter tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/tc_noir"
            app:tabTextColor="@color/tc_on_dark_secondary"
            app:tabSelectedTextColor="@color/white"
            app:tabIndicatorColor="@color/tc_red"
            app:tabIndicatorHeight="3dp"
            app:tabIndicatorFullWidth="false"
            app:tabInlineLabel="true"
            app:tabRippleColor="@color/tc_on_dark_divider"
            app:tabTextAppearance="@style/TextAppearance.TiredCity.OrderTab"
            app:tabPaddingStart="14dp"
            app:tabPaddingEnd="14dp"
            app:tabMode="scrollable">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_tab_all" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_tab_pending" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_tab_shipping" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_tab_received" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_tab_cancelled" />
        </com.google.android.material.tabs.TabLayout>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_orders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/tc_space_lg"
            android:paddingBottom="20dp"
            android:clipToPadding="false" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_empty_badge"
            android:layout_marginBottom="22dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cart"
                app:tint="@color/tc_red"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_empty_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_empty_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="26dp" />

        <Button
            android:id="@+id/btn_shop_now"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/tc_btn_red_pill"
            android:paddingHorizontal="34dp"
            android:text="@string/order_shop_now"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium"
            android:elevation="2dp" />
    </LinearLayout>
</LinearLayout>
