<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ "gợi ý trang phục" (AI Styling theo Ngũ Hành) — ảnh KHÔNG bị cắt (adjustViewBounds +
     fitCenter, tự co giãn theo tỉ lệ ảnh thật), khối thông tin nằm bên dưới ảnh trên nền kem
     (không đè chữ lên ảnh), cộng huy hiệu lưu yêu thích hình ngôi sao nền đỏ đè góc ảnh. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="@dimen/tc_radius_lg"
    app:cardElevation="@dimen/tc_elev_sm"
    app:strokeColor="@color/tc_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ảnh — không bị cắt, tự co giãn theo tỉ lệ thật của ảnh -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_product_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:background="@color/bg_subtle"
                android:contentDescription="@null"
                tools:src="@android:drawable/ic_menu_gallery" />

            <!-- Badge giảm giá, góc trên-phải -->
            <TextView
                android:id="@+id/tv_discount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/tc_bg_discount"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                tools:text="-15%"
                tools:visibility="visible" />

            <!-- Nút lưu yêu thích — huy hiệu tròn đỏ đè góc trên-trái của ảnh -->
            <com.tiredcity.app.ui.widget.FavoriteButton
                android:id="@+id/ib_save"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/tc_bg_circle_red"
                app:tint="@android:color/white"
                android:contentDescription="@string/btn_save"
                android:padding="7dp" />
        </FrameLayout>

        <!-- Thông tin — nền kem, chữ tối -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Áo Dài Cổ Truyền" />

            <TextView
                android:id="@+id/tv_product_material"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                tools:text="Lụa tơ tằm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_color_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tc_bg_color_tag"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/chip_text_default"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone"
                    tools:text="Đỏ"
                    tools:visibility="visible" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_product_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tc_red"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    tools:text="850.000 ₫" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
