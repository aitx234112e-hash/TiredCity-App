<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ "gợi ý trang phục" (AI Styling theo Ngũ Hành) — cùng khuôn "poster" với
     item_related_product.xml / item_styling_category.xml: ảnh phủ kín + lớp phủ tối dần đáy +
     tên sản phẩm chữ trắng in hoa + nút mũi tên tròn trắng góc dưới-phải. Không giá/tag màu/sao
     đánh giá — tối giản đúng theo mẫu tham khảo. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/tc_radius_lg"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:contentPadding="0dp"
    app:rippleColor="@color/tc_on_dark_divider"
    tools:cardBackgroundColor="@color/tc_swatch_xanh_la">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ImageView
            android:id="@+id/iv_product_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/bg_subtle"
            android:contentDescription="@null"
            tools:src="@android:drawable/ic_menu_gallery" />

        <!-- Vệt sáng chéo "tráng gương" lướt 1 lần khi thẻ hiện ra -->
        <View
            android:id="@+id/shine_product_image"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/tc_shimmer_gradient"
            android:rotation="-18" />

        <!-- Lớp phủ tối dần về đáy để chữ trắng luôn nổi rõ trên mọi ảnh nền -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tc_category_card_scrim" />

        <!-- Tên sản phẩm, góc dưới-trái -->
        <TextView
            android:id="@+id/tv_product_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:padding="12dp"
            android:paddingEnd="40dp"
            android:textColor="@android:color/white"
            android:textAllCaps="true"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Trà Ngọc Duyên Dáng" />

        <!-- Mũi tên gợi ý "có thể chạm", góc dưới-phải -->
        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="@drawable/tc_bg_circle_white">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/tc_red"
                android:contentDescription="@null" />
        </FrameLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
