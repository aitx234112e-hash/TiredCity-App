<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tc_bg_main">

    <!-- ── Ô tìm kiếm + giỏ hàng — nền đen trên cùng (đồng bộ với khối tab + carousel
         bên dưới); giỏ hàng là nút tròn đỏ nổi bật như 1 CTA thay vì icon phẳng ── -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/tc_noir"
        android:paddingStart="@dimen/tc_space_xl"
        android:paddingEnd="@dimen/tc_space_lg"
        android:paddingTop="@dimen/tc_space_md"
        android:paddingBottom="@dimen/tc_space_lg">

        <!-- Ô tìm kiếm — thẻ trắng nổi nhẹ (thay nền be phẳng cũ) để bật lên trên nền kem -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ll_search"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/tc_radius_pill"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:contentPadding="0dp"
            app:rippleColor="@color/tc_red_pale">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/tc_red"
                    android:contentDescription="@string/search_hint" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/search_hint"
                    android:textColor="@color/tc_text_primary"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/ib_scan"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_scan"
                    app:tint="@color/tc_text_secondary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_scan" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Giỏ hàng -->
        <FrameLayout
            android:id="@+id/btn_cart"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/tc_bg_circle_red"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cart"
                app:tint="@color/tc_on_red"
                android:contentDescription="@string/cd_cart" />

            <TextView
                android:id="@+id/tv_cart_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="-2dp"
                android:layout_marginEnd="-2dp"
                android:minWidth="17dp"
                android:minHeight="17dp"
                android:paddingHorizontal="4dp"
                android:gravity="center"
                android:background="@drawable/tc_badge_count_on_red"
                android:textColor="@color/tc_espresso"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />
        </FrameLayout>

    </LinearLayout>

    <!-- ── Tab nhóm kiểu áo (ÁO DÀI / NHẬT BÌNH / ÁO TẤC / GIAO LĨNH / YẾM ĐÀO) — gạch chân đỏ
         báo hiệu tab đang chọn, chữ trắng đậm để đọc rõ trên nền đen. ── -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_groups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tc_noir"
        android:paddingStart="@dimen/tc_space_lg"
        android:paddingEnd="@dimen/tc_space_lg"
        android:paddingTop="@dimen/tc_space_sm"
        android:paddingBottom="@dimen/tc_space_md"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabPaddingStart="14dp"
        app:tabPaddingEnd="14dp"
        app:tabPaddingTop="6dp"
        app:tabPaddingBottom="6dp"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorColor="@color/tc_red"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="@android:color/white"
        app:tabTextColor="@color/tc_on_dark_secondary"
        app:tabRippleColor="@color/tc_on_dark_divider"
        app:tabTextAppearance="@style/TextAppearance.TC.CategoryTab" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Banner ảnh trang phục THẬT của danh mục đang chọn (Horizontal Scroll Section)
                 — ảnh full-bleed cuộn ngang như 1 banner quảng cáo, không viền/thẻ nổi — nền đen
                 liền mạch với khối tab phía trên, kết thúc ở dòng gợi ý vuốt. ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/tc_noir"
                android:paddingBottom="@dimen/tc_space_xl">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_category_carousel"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />

                <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                    android:id="@+id/dots_category_carousel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    app:dotsColor="@color/tc_sand_light"
                    app:selectedDotColor="@color/tc_red"
                    app:dotsSize="8dp"
                    app:dotsSpacing="5dp" />
            </LinearLayout>

            <!-- ── Danh sách danh mục màu — ảnh mẫu vải THẬT cho từng thẻ, lần lượt mờ+trượt vào
                 khi hiện ra (xem StylingAdapter.playEntrance). ── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:paddingStart="@dimen/tc_space_xl"
                android:paddingEnd="@dimen/tc_space_xl"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
