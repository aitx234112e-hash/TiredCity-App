<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tc_red"
    android:fitsSystemWindows="true">

    <!-- ── Header đỏ, chữ trắng ────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/tc_red"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            android:scaleType="centerInside"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/reward_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:fontFamily="sans-serif-medium" />

        <!-- Hộp quà đỏ trong vòng tròn trắng -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical">

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/tc_bg_circle_white" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_gift"
                app:tint="@color/tc_red"
                android:contentDescription="@string/cd_gift" />
        </FrameLayout>
    </FrameLayout>

    <!-- ── Tabs: nền đen, chữ trắng ────────────────────────────────────── -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/tc_reward_tab_bg"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabPaddingStart="16dp"
        app:tabPaddingEnd="16dp"
        app:tabIndicatorColor="@color/tc_gold"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabTextColor="@color/tc_reward_tab_text"
        app:tabSelectedTextColor="@color/tc_reward_tab_text_selected"
        app:tabTextAppearance="@style/TextAppearance.TiredCity.RewardTab"
        app:tabRippleColor="@color/tc_red_ripple" />

    <!-- ── Nội dung tab (nền trắng) ────────────────────────────────────── -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white" />
</LinearLayout>
