<?xml version="1.0" encoding="utf-8"?>
<!-- Một trang của carousel ảnh trang phục (Horizontal Scroll Section) ở đầu trang "Danh mục" —
     chỉ ảnh full-bleed, không chữ đè. ViewPager2.PageTransformer (StylingFragment.
     CenterScalePageTransformer, giống HomeFragment) phóng to trang đang ở giữa. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="@dimen/tc_radius_lg"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/tc_bg_subtle"
    app:contentPadding="0dp">

    <ImageView
        android:id="@+id/iv_carousel_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@android:drawable/ic_menu_gallery"
        android:contentDescription="@null" />
</com.google.android.material.card.MaterialCardView>
