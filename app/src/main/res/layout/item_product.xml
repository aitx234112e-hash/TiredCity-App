<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="165dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="@dimen/tc_radius_md"
    app:cardElevation="@dimen/tc_elev_sm"
    app:strokeColor="@color/tc_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ảnh + badge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/iv_product_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/bg_subtle"
                android:contentDescription="@null"
                tools:src="@android:drawable/ic_menu_gallery" />

            <!-- Badge giảm giá -->
            <TextView
                android:id="@+id/tv_discount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/tc_bg_discount"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                tools:text="-15%"
                tools:visibility="visible" />

            <!-- Nút lưu yêu thích -->
            <com.tiredcity.app.ui.widget.FavoriteButton
                android:id="@+id/ib_save"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/tc_bg_circle_white"
                android:contentDescription="@string/btn_save"
                android:padding="7dp" />
        </FrameLayout>

        <!-- Thông tin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:minLines="2"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                tools:text="Áo Dài Cổ Truyền" />

            <TextView
                android:id="@+id/tv_product_material"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                tools:text="Lụa tơ tằm" />

            <TextView
                android:id="@+id/tv_color_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/tc_bg_color_tag"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/chip_text_default"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                tools:text="Đỏ"
                tools:visibility="visible" />

            <RatingBar
                android:id="@+id/rb_rating"
                style="@style/Widget.AppCompat.RatingBar.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:isIndicator="true"
                android:numStars="5"
                android:progressTint="@color/tc_gold"
                android:secondaryProgressTint="@color/bg_subtle"
                android:stepSize="0.5"
                tools:rating="4.5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_product_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/tc_red"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    tools:text="850.000 ₫" />

                <ImageButton
                    android:id="@+id/btn_quick_add"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/tc_bg_circle_red"
                    android:src="@drawable/ic_cart"
                    app:tint="@color/white"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/btn_add_to_cart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
