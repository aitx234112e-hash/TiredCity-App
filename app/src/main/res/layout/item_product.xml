<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ sản phẩm poster full-bleed — dùng chung cho cả 3 chế độ xem (1/2/3 cột) của
     CategoryActivity: không viền, không bo góc, ảnh phủ kín toàn bộ thẻ. Lớp phủ tối dần đáy
     để khối thông tin (tên, chất liệu, tag màu, sao, giá) đè lên đáy ảnh luôn đủ tương phản.
     Chiều cao ảnh do ProductAdapter set theo số cột đang chọn (setSpanCount). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fl_image"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_margin="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/iv_product_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@color/bg_subtle"
        android:contentDescription="@null"
        tools:src="@android:drawable/ic_menu_gallery" />

    <!-- Lớp phủ tối dần từ trong suốt (đỉnh) xuống đen mờ (đáy) để khối thông tin luôn nổi rõ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tc_category_card_scrim" />

    <!-- Badge giảm giá -->
    <TextView
        android:id="@+id/tv_discount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/tc_bg_discount"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        tools:text="-15%"
        tools:visibility="visible" />

    <!-- Nút lưu yêu thích -->
    <com.tiredcity.app.ui.widget.FavoriteButton
        android:id="@+id/ib_save"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/tc_bg_circle_white"
        android:contentDescription="@string/btn_save"
        android:padding="7dp" />

    <!-- Thông tin sản phẩm, đè lên đáy ảnh -->
    <LinearLayout
        android:id="@+id/ll_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_product_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            tools:text="Áo Dài Cổ Truyền" />

        <TextView
            android:id="@+id/tv_product_material"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/tc_on_dark_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Lụa tơ tằm" />

        <TextView
            android:id="@+id/tv_color_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/tc_bg_color_tag"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/chip_text_default"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"
            tools:text="Đỏ"
            tools:visibility="visible" />

        <RatingBar
            android:id="@+id/rb_rating"
            style="@style/Widget.AppCompat.RatingBar.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:isIndicator="true"
            android:numStars="5"
            android:progressTint="@color/tc_gold"
            android:secondaryProgressTint="@color/tc_on_dark_divider"
            android:stepSize="0.5"
            tools:rating="4.5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_product_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tc_red"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                tools:text="850.000 ₫" />

            <ImageButton
                android:id="@+id/btn_quick_add"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/tc_bg_circle_red"
                android:src="@drawable/ic_cart"
                app:tint="@color/white"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:contentDescription="@string/btn_add_to_cart" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
