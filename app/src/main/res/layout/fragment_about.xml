<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:descendantFocusability="blocksDescendants"
        android:paddingBottom="@dimen/tc_space_3xl">

        <!-- descendantFocusability=blocksDescendants: chặn NestedScrollView tự cuộn xuống
             ô Liên hệ (focusable) khi mở trang, khiến trang bị "nhảy" ra giữa thay vì bắt
             đầu từ đầu. Các hàng Liên hệ vẫn bấm được bằng chạm. -->

        <!-- ═══ Hero — đỏ, full-bleed: rooster mark + wordmark + video Behance ═══ -->
        <LinearLayout
            android:id="@+id/section_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/tc_red"
            android:paddingHorizontal="@dimen/tc_space_xl"
            android:paddingTop="@dimen/tc_space_3xl"
            android:paddingBottom="@dimen/tc_space_2xl"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_tc_logo"
                app:tint="@color/tc_on_red"
                android:contentDescription="@string/app_name" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="@dimen/tc_space_sm"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_main"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tc_space_xs"
                android:text="@string/about_hero_subtitle"
                android:textColor="@color/tc_on_red_secondary"
                android:textSize="13sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Chiều cao 16:9 được set bằng code (AboutFragment.applyAspectRatio) sau khi đo được
             chiều rộng thực tế — đáng tin cậy hơn app:layout_constraintDimensionRatio, vốn không
             luôn tính đúng khi ở sâu trong cây layout cuộn. -->
        <FrameLayout
            android:id="@+id/section_video_behance"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/tc_red">

            <VideoView
                android:id="@+id/video_behance"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:contentDescription="@string/about_hero_image_desc" />
        </FrameLayout>

        <!-- ═══ Về chúng tôi — kem: logo grid + thẻ text ═══ -->
        <LinearLayout
            android:id="@+id/section_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/tc_cream">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:scaleType="centerCrop"
                android:src="@drawable/about_logo_grid"
                android:contentDescription="@string/about_section_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/tc_space_xl"
                android:paddingVertical="@dimen/tc_space_3xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_section_title"
                    android:textColor="@color/tc_red"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/tc_space_md" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_description"
                    android:textColor="@color/tc_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Tầm nhìn — full-bleed: gif logo transform ═══ -->
        <LinearLayout
            android:id="@+id/section_vision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/tc_bg_card"
            android:paddingHorizontal="@dimen/tc_space_xl"
            android:paddingVertical="@dimen/tc_space_3xl">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginBottom="@dimen/tc_space_xl">

                <ImageView
                    android:id="@+id/iv_vision_gif"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/about_vision_title" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_vision_title"
                android:textColor="@color/tc_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="@dimen/tc_space_md" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_vision_desc"
                android:textColor="@color/tc_text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- ═══ Sứ mệnh — full-bleed: video logo transform ═══ -->
        <!-- Video tách thành sibling full-bleed riêng (giống section_video_behance). Chiều cao
             16:9 được set bằng code (AboutFragment.applyAspectRatio), không dùng
             app:layout_constraintDimensionRatio. -->
        <FrameLayout
            android:id="@+id/section_video_mission"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/tc_bg_card">

            <VideoView
                android:id="@+id/video_logo_transform"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:contentDescription="@string/about_mission_title" />
        </FrameLayout>

        <!-- Nền sáng giống Tầm nhìn (không dùng đỏ) vì about_mission_desc có các đoạn
             <font color="tc_red"> lồng sẵn — trên nền sáng, chữ nhấn mạnh vẫn nổi rõ. -->
        <LinearLayout
            android:id="@+id/section_mission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/tc_bg_card"
            android:paddingHorizontal="@dimen/tc_space_xl"
            android:paddingVertical="@dimen/tc_space_3xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_mission_title"
                android:textColor="@color/tc_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="@dimen/tc_space_md" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_mission_desc"
                android:textColor="@color/tc_text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/tc_space_xl">

            <!-- ═══ Giá trị cốt lõi — lưới ô màu caro đỏ/sáng, gợi lại logo grid phía trên ═══ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tc_space_3xl"
                android:layout_marginBottom="@dimen/tc_space_lg"
                android:text="@string/about_core_values_title"
                android:textColor="@color/tc_red"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Bản sắc Việt — đỏ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/tc_space_xs"
                    app:cardCornerRadius="@dimen/tc_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/tc_red">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/tc_space_md"
                        android:paddingVertical="@dimen/tc_space_xl">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/about_value1_title"
                            android:src="@drawable/ic_bamboo"
                            app:tint="@color/tc_on_red" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tc_space_md"
                            android:text="@string/about_value1_title"
                            android:textColor="@color/tc_on_red"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tc_space_micro"
                            android:text="@string/about_value1_desc"
                            android:textColor="@color/tc_on_red_secondary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sáng tạo — nền sáng -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/tc_space_xs"
                    app:cardCornerRadius="@dimen/tc_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/tc_bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/tc_space_md"
                        android:paddingVertical="@dimen/tc_space_xl">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/about_value2_title"
                            android:src="@drawable/ic_lotus"
                            app:tint="@color/tc_red" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tc_space_md"
                            android:text="@string/about_value2_title"
                            android:textColor="@color/tc_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tc_space_micro"
                            android:text="@string/about_value2_desc"
                            android:textColor="@color/tc_text_secondary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Công nghệ — nền sáng -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/tc_space_xs"
                    app:cardCornerRadius="@dimen/tc_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/tc_bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/tc_space_md"
                        android:paddingVertical="@dimen/tc_space_xl">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/about_value3_title"
                            android:src="@drawable/ic_temple"
                            app:tint="@color/tc_red" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tc_space_md"
                            android:text="@string/about_value3_title"
                            android:textColor="@color/tc_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tc_space_micro"
                            android:text="@string/about_value3_desc"
                            android:textColor="@color/tc_text_secondary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Kết nối — đỏ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/tc_space_xs"
                    app:cardCornerRadius="@dimen/tc_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/tc_red">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/tc_space_md"
                        android:paddingVertical="@dimen/tc_space_xl">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/about_value4_title"
                            android:src="@drawable/ic_lanterns"
                            app:tint="@color/tc_on_red" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tc_space_md"
                            android:text="@string/about_value4_title"
                            android:textColor="@color/tc_on_red"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tc_space_micro"
                            android:text="@string/about_value4_desc"
                            android:textColor="@color/tc_on_red_secondary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ═══ Liên hệ ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tc_space_3xl"
                app:cardCornerRadius="@dimen/tc_radius_md"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/tc_space_xl">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_contact_title"
                        android:textColor="@color/tc_red"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tc_space_micro"
                        android:layout_marginBottom="@dimen/tc_space_lg"
                        android:text="@string/about_contact_brand"
                        android:textColor="@color/tc_text_secondary"
                        android:textSize="12sp" />

                    <!-- Showroom Hà Nội -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/tc_space_lg">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="1dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_pin"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_showroom_hn_title" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/about_showroom_hn_title"
                                android:textColor="@color/tc_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/about_showroom_hn_address"
                                android:textColor="@color/tc_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Showroom TP.HCM -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/tc_space_lg">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="1dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_pin"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_showroom_hcm_title" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/about_showroom_hcm_title"
                                android:textColor="@color/tc_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/about_showroom_hcm_address"
                                android:textColor="@color/tc_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="@dimen/tc_space_lg"
                        android:background="@color/tc_divider" />

                    <!-- Email -->
                    <LinearLayout
                        android:id="@+id/row_contact_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="@dimen/tc_space_xs"
                        android:layout_marginBottom="@dimen/tc_space_xs">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_email"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_email" />

                        <TextView
                            android:id="@+id/tv_email"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_email"
                            android:textColor="@color/tc_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Hotline -->
                    <LinearLayout
                        android:id="@+id/row_contact_hotline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="@dimen/tc_space_xs"
                        android:layout_marginBottom="@dimen/tc_space_xs">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_phone"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_hotline" />

                        <TextView
                            android:id="@+id/tv_hotline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_hotline"
                            android:textColor="@color/tc_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Website -->
                    <LinearLayout
                        android:id="@+id/row_contact_website"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="@dimen/tc_space_xs"
                        android:layout_marginBottom="@dimen/tc_space_xs">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_language"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_website" />

                        <TextView
                            android:id="@+id/tv_website"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_website"
                            android:textColor="@color/tc_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Giờ hoạt động -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/tc_space_xs">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_clock"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_hours" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_hours"
                            android:textColor="@color/tc_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
