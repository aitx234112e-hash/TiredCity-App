<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/tc_space_3xl">

        <!-- ═══ Hero: horizontal image ═══ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/tc_bg_subtle">

            <ImageView
                android:id="@+id/iv_hero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_about_us"
                android:contentDescription="@string/about_hero_image_desc" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/tc_space_xl">

            <!-- ═══ Về chúng tôi — text trái / ảnh phải ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/tc_space_2xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_section_title"
                    android:textColor="@color/tc_red"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/tc_space_md" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/tc_space_lg"
                        android:text="@string/about_description"
                        android:textColor="@color/tc_text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />

                    <FrameLayout
                        android:layout_width="124dp"
                        android:layout_height="124dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:layout_gravity="center"
                            android:rotation="-14"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="@color/tc_gold_pale" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="center"
                            android:rotation="10"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="@color/tc_bg_card" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_about"
                            android:layout_width="108dp"
                            android:layout_height="108dp"
                            android:layout_gravity="center"
                            android:rotation="-3"
                            android:elevation="8dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/banner_about_us_03"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.TC.Medium"
                            android:contentDescription="@string/about_section_title" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Tầm nhìn — ảnh trái / text phải (so le) ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/tc_space_3xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_vision_title"
                    android:textColor="@color/tc_red"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/tc_space_md" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="124dp"
                        android:layout_height="124dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:layout_gravity="center"
                            android:rotation="14"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="@color/tc_gold_pale" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="center"
                            android:rotation="-10"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="@color/tc_bg_card" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_vision"
                            android:layout_width="108dp"
                            android:layout_height="108dp"
                            android:layout_gravity="center"
                            android:rotation="3"
                            android:elevation="8dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/banner_about_us_02"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.TC.Medium"
                            android:contentDescription="@string/about_vision_title" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/tc_space_lg"
                        android:text="@string/about_vision_desc"
                        android:textColor="@color/tc_text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Sứ mệnh — text trái / ảnh phải (so le) ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/tc_space_3xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_mission_title"
                    android:textColor="@color/tc_red"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/tc_space_md" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/tc_space_lg"
                        android:text="@string/about_mission_desc"
                        android:textColor="@color/tc_text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />

                    <FrameLayout
                        android:layout_width="124dp"
                        android:layout_height="124dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:layout_gravity="center"
                            android:rotation="-14"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="@color/tc_gold_pale" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="center"
                            android:rotation="10"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="@color/tc_bg_card" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_mission"
                            android:layout_width="108dp"
                            android:layout_height="108dp"
                            android:layout_gravity="center"
                            android:rotation="-3"
                            android:elevation="8dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/banner_about_us_01"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.TC.Medium"
                            android:contentDescription="@string/about_mission_title" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Giá trị cốt lõi ═══ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/tc_space_3xl"
                android:background="@color/tc_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tc_space_2xl"
                android:layout_marginBottom="@dimen/tc_space_xl"
                android:text="@string/about_core_values_title"
                android:textColor="@color/tc_red"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Bản sắc Việt -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/tc_space_xs">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/tc_bg_circle_cream">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_heritage"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_value1_title" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tc_space_sm"
                        android:text="@string/about_value1_title"
                        android:textColor="@color/tc_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tc_space_micro"
                        android:text="@string/about_value1_desc"
                        android:textColor="@color/tc_text_secondary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Sáng tạo -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/tc_space_xs">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/tc_bg_circle_cream">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_style"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_value2_title" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tc_space_sm"
                        android:text="@string/about_value2_title"
                        android:textColor="@color/tc_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tc_space_micro"
                        android:text="@string/about_value2_desc"
                        android:textColor="@color/tc_text_secondary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tc_space_xl"
                android:orientation="horizontal">

                <!-- Công nghệ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/tc_space_xs">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/tc_bg_circle_cream">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_auto_style"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_value3_title" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tc_space_sm"
                        android:text="@string/about_value3_title"
                        android:textColor="@color/tc_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tc_space_micro"
                        android:text="@string/about_value3_desc"
                        android:textColor="@color/tc_text_secondary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Kết nối -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/tc_space_xs">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/tc_bg_circle_cream">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_community"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_value4_title" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tc_space_sm"
                        android:text="@string/about_value4_title"
                        android:textColor="@color/tc_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tc_space_micro"
                        android:text="@string/about_value4_desc"
                        android:textColor="@color/tc_text_secondary"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Liên hệ ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tc_space_3xl"
                app:cardCornerRadius="@dimen/tc_radius_md"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/tc_space_xl">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_contact_title"
                        android:textColor="@color/tc_red"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tc_space_micro"
                        android:layout_marginBottom="@dimen/tc_space_lg"
                        android:text="@string/about_contact_brand"
                        android:textColor="@color/tc_text_secondary"
                        android:textSize="12sp" />

                    <!-- Showroom Hà Nội -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/tc_space_lg">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="1dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_pin"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_showroom_hn_title" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/about_showroom_hn_title"
                                android:textColor="@color/tc_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/about_showroom_hn_address"
                                android:textColor="@color/tc_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Showroom TP.HCM -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/tc_space_lg">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="1dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_pin"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_showroom_hcm_title" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/about_showroom_hcm_title"
                                android:textColor="@color/tc_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/about_showroom_hcm_address"
                                android:textColor="@color/tc_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="@dimen/tc_space_lg"
                        android:background="@color/tc_divider" />

                    <!-- Email -->
                    <LinearLayout
                        android:id="@+id/row_contact_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="@dimen/tc_space_xs"
                        android:layout_marginBottom="@dimen/tc_space_xs">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_email"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_email" />

                        <TextView
                            android:id="@+id/tv_email"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_email"
                            android:textColor="@color/tc_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Hotline -->
                    <LinearLayout
                        android:id="@+id/row_contact_hotline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="@dimen/tc_space_xs"
                        android:layout_marginBottom="@dimen/tc_space_xs">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_phone"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_hotline" />

                        <TextView
                            android:id="@+id/tv_hotline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_hotline"
                            android:textColor="@color/tc_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Website -->
                    <LinearLayout
                        android:id="@+id/row_contact_website"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="@dimen/tc_space_xs"
                        android:layout_marginBottom="@dimen/tc_space_xs">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_language"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_website" />

                        <TextView
                            android:id="@+id/tv_website"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_website"
                            android:textColor="@color/tc_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Giờ hoạt động -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/tc_space_xs">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="@dimen/tc_space_md"
                            android:src="@drawable/ic_clock"
                            android:tint="@color/tc_red"
                            android:contentDescription="@string/about_hours" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_hours"
                            android:textColor="@color/tc_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
