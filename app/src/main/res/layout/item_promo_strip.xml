<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Ảnh voucher đã có sẵn chữ/thiết kế, không đè thêm text/scrim. fitCenter + khung được
         HomeFragment đo đúng theo tỷ lệ ảnh gốc (applyAspectRatio) → hiện FULL ảnh, không cắt. -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_promo_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tc_bg_card"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.TC.Large" />
</FrameLayout>
