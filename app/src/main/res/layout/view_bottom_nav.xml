<?xml version="1.0" encoding="utf-8"?>
<!--
  ════════════ THANH NAV LƠ LỬNG (Threads style) ════════════
  Layout dùng chung cho MainActivity (3 tab trong nav_graph) lẫn SearchActivity / ProfileActivity
  (2 màn Activity riêng) — nhờ vậy thanh nav không biến mất khi bấm icon "Tìm kiếm" hay "Tôi".
  Xem com.tiredcity.app.ui.common.BottomNavBar để biết cách gắn sự kiện + trạng thái chọn.

  Lưu ý: chiều cao/margin do phía <include> quyết định, và phải gọi
  EdgeToEdgeUtils.applyNavBarBottomMargin() để thanh không chui xuống dưới thanh hệ thống.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="@drawable/tc_bg_navbar_float"
    android:elevation="16dp"
    android:paddingHorizontal="8dp">

    <!-- Cửa hàng -->
    <FrameLayout
        android:id="@+id/navShop"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/navShopIcon"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_search"
            app:tint="@color/tc_nav_icon_inactive"
            android:contentDescription="@string/nav_short_shop" />
    </FrameLayout>

    <!-- Phối đồ -->
    <FrameLayout
        android:id="@+id/navStyling"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/navStylingIcon"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/tc_nav_styling"
            app:tint="@color/tc_nav_icon_inactive"
            android:contentDescription="@string/nav_short_styling" />
    </FrameLayout>

    <!-- Trang chủ -->
    <FrameLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/navHomeIcon"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/tc_nav_home"
            app:tint="@color/tc_nav_icon_inactive"
            android:contentDescription="@string/nav_short_home" />
    </FrameLayout>

    <!-- Khám phá -->
    <FrameLayout
        android:id="@+id/navExplore"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/navExploreIcon"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/tc_nav_explore"
            app:tint="@color/tc_nav_icon_inactive"
            android:contentDescription="@string/nav_short_explore" />
    </FrameLayout>

    <!-- Tôi (Profile) -->
    <FrameLayout
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/navProfileIcon"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/tc_nav_profile"
            app:tint="@color/tc_nav_icon_inactive"
            android:contentDescription="@string/nav_short_profile" />
    </FrameLayout>
</LinearLayout>
