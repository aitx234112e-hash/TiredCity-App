<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/tc_red"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        app:title="@string/styling_ai_title"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="@style/TextAppearance.TiredCity.Toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <!-- ───────────── BANNER MỆNH THẬT — ảnh thương hiệu đúng mệnh của người dùng (tính từ
                 ngày sinh, xem AiStylingActivity#loadHeroBanner()). Không còn carousel/vuốt qua
                 mệnh khác — trang chỉ hiển thị đúng 1 mệnh của người dùng. ───────────── -->
            <FrameLayout
                android:id="@+id/hero_menh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_primary">

                <ImageView
                    android:id="@+id/iv_menh_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/menh_banner_kim" />
            </FrameLayout>

            <!-- ───────────── NỘI DUNG (có lề hai bên) ───────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp">

                <!-- ───────────── MỞ ĐẦU — nhãn "ngũ hành bản mệnh" + nhãn "mệnh của bạn", tiêu đề
                     lớn "Mệnh {tên}" và câu mô tả khí chất/màu sắc, đổi theo đúng mệnh đang xem
                     trên carousel (xem AiStylingActivity#updateViewingMenhUi()). ───────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tv_menh_eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/menh_prefix"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.16"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_your_menh_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/tc_bg_pill_tag"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="@string/aistyle_your_menh_tag"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_menh_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    tools:text="@string/aistyle_menh_title_kim" />

                <TextView
                    android:id="@+id/tv_menh_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    tools:text="@string/aistyle_menh_desc_kim" />

                <!-- ───────────── SẮC MÀU NGŨ HÀNH — ảnh minh hoạ nguyên khổ (không cắt xén) + bài
                     viết ngắn theo đúng mệnh của người dùng. Nền trắng như phần còn lại của trang;
                     chỉ gạch chân dưới tiêu đề mang màu mệnh (xem updateMenhColors()). Ẩn hoàn toàn
                     nếu mệnh chưa có ảnh (xem MenhCalculator#getMenhColorPhotos). ───────────── -->
                <LinearLayout
                    android:id="@+id/section_menh_colors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_colors_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/aistyle_colors_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/divider_colors"
                        android:layout_width="48dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/tc_divider_gold" />

                    <!-- clipChildren=false: thẻ ảnh bên trong trôi lên xuống bằng translationY (xem
                         startGentleFloat()); nếu vẫn clip theo bounds của LinearLayout này thì mép
                         trên của ảnh sẽ bị xén đúng bằng biên độ trôi. -->
                    <LinearLayout
                        android:id="@+id/layout_menh_colors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tv_colors_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="6dp"
                        tools:text="@string/aistyle_colors_text_kim" />
                </LinearLayout>

                <!-- ───────────── NGHỆ THUẬT ĐIỂM XUYẾT — dải ảnh phụ kiện tự trượt trái ⇄ phải +
                     bài viết ngắn theo đúng mệnh của người dùng. Nền trắng như phần còn lại của
                     trang; chỉ gạch chân dưới tiêu đề mang màu mệnh (xem updateMenhAccessories()).
                     Ẩn hoàn toàn nếu mệnh chưa có ảnh. ───────────── -->
                <LinearLayout
                    android:id="@+id/section_menh_accessories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_accessories_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/aistyle_accessories_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/divider_accessories"
                        android:layout_width="48dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/tc_divider_gold" />

                    <HorizontalScrollView
                        android:id="@+id/scroll_menh_accessories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layout_menh_accessories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tv_accessories_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="6dp"
                        tools:text="@string/aistyle_accessories_text_kim" />
                </LinearLayout>

                <!-- ───────────── LỜI KHUYÊN PHONG CÁCH — thẻ nền trắng mờ nhất có thể (15% alpha,
                     xem @drawable/tc_bg_tips_panel), khác với 2 mục sắc màu/điểm xuyết bên trên vốn
                     để trần trên nền trang. Tiêu đề + gạch chân mang màu mệnh (xem
                     updateTipsAndSuggestionsTheme()). ───────────── -->
                <LinearLayout
                    android:id="@+id/section_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/tc_bg_tips_panel"
                    android:padding="14dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/tv_tips_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/aistyle_tips"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/divider_tips"
                        android:layout_width="48dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/tc_divider_gold" />

                    <TextView
                        android:id="@+id/tv_styling_tip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="6dp"
                        tools:text="@string/aistyle_tip_desc_kim" />
                </LinearLayout>

                <!-- ───────────── GỢI Ý TRANG PHỤC (lưới thoáng trên nền kem) — theo đúng mệnh thật
                     của người dùng, cùng với các mục màu/phụ kiện/lời khuyên bên trên. Tiêu đề mang
                     màu mệnh (xem updateTipsAndSuggestionsTheme()). ───────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_suggestions_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/aistyle_suggestions"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_refresh_suggestions"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="0dp"
                            android:background="@drawable/tc_btn_ghost_red"
                            android:drawableEnd="@drawable/ic_arrow_right"
                            android:drawablePadding="6dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/aistyle_see_more"
                            android:textColor="@color/tc_red"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:drawableTint="@color/tc_red" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_suggestions"
                        android:layout_width="48dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/tc_divider_gold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_suggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="-8dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
