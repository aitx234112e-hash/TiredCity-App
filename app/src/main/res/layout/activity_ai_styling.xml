<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/tc_red"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        app:title="@string/styling_ai_title"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="@style/TextAppearance.TiredCity.Toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <!-- ───────────── HERO TRANH MỆNH (tràn viền) ───────────── -->
            <FrameLayout
                android:id="@+id/hero_menh"
                android:layout_width="match_parent"
                android:layout_height="440dp"
                android:background="@drawable/tc_bg_menh_result">

                <!-- Tranh minh hoạ theo mệnh (đổi ảnh theo từng mệnh trong code) -->
                <ImageView
                    android:id="@+id/img_menh_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ai_1"
                    android:contentDescription="@string/styling_ai_title" />

                <!-- Phủ tối nhẹ ở đỉnh (nối liền toolbar đỏ) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_gravity="top"
                    android:background="@drawable/tc_scrim_hero_top" />

                <!-- Phủ tối ở đáy để chữ nổi rõ -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/tc_gradient_bottom_scrim" />

                <!-- Nhãn phụ NGŨ HÀNH (chip kính mờ, góc trên) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/tc_bg_menh_eyebrow_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/menh_cta_eyebrow"
                    android:textColor="@color/tc_gold_bright"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14" />

                <!-- Khối thông tin mệnh, canh đáy -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingBottom="20dp">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/tc_bg_circle_gold_ring">

                        <TextView
                            android:id="@+id/tv_menh_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🪙"
                            android:textSize="28sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_menh_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mệnh Kim"
                            android:textColor="@color/tc_gold_bright"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:shadowColor="#B3000000"
                            android:shadowDx="0"
                            android:shadowDy="2"
                            android:shadowRadius="8" />

                        <TextView
                            android:id="@+id/tv_menh_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/aistyle_menh_tagline"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:alpha="0.92"
                            android:shadowColor="#99000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="6" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ───────────── NỘI DUNG (có lề hai bên) ───────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <!-- ───────────── BẢNG MÀU HỢP MỆNH (nền đen tuyền) ───────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="@dimen/tc_radius_lg"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/tc_gold"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/black">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/aistyle_palette"
                            android:textColor="@color/tc_gold_bright"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="48dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/tc_divider_gold" />

                        <LinearLayout
                            android:id="@+id/layout_colors"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp" />

                        <TextView
                            android:id="@+id/tv_color_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/aistyle_color_desc"
                            android:textColor="@color/tc_text_on_dark"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ───────────── GỢI Ý TRANG PHỤC (lưới thoáng trên nền kem) ───────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/aistyle_suggestions"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_refresh_suggestions"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minWidth="0dp"
                            android:background="@drawable/tc_btn_ghost_red"
                            android:drawableStart="@drawable/ic_refresh"
                            android:drawablePadding="6dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/aistyle_refresh"
                            android:textColor="@color/tc_red"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:drawableTint="@color/tc_red" />
                    </LinearLayout>

                    <View
                        android:layout_width="48dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/tc_divider_gold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_suggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="-8dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />
                </LinearLayout>

                <!-- ───────────── LỜI KHUYÊN PHONG CÁCH ───────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/tc_radius_lg"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/tc_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/bg_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/aistyle_tips"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="48dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/tc_divider_gold" />

                        <TextView
                            android:id="@+id/tv_styling_tip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/aistyle_tip_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
