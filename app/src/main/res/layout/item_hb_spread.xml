<?xml version="1.0" encoding="utf-8"?>
<!--
  Một "kỳ" (spread) của chuyên đề Hát Bội: số thứ tự + tên chương + phụ đề,
  khung ảnh viền vàng kim ôm trọn trang tạp chí (fitCenter, không cắt), và một
  dòng chú thích biên tập. Được HatBoiMagazineActivity nhân bản cho từng trang.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/tc_space_xl"
    android:paddingTop="@dimen/tc_space_2xl">

    <!-- Hàng tiêu đề chương: số vòng vàng + tên + phụ đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_no"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/hb_num_circle"
            android:gravity="center"
            android:textColor="@color/brand_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="01" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tc_space_md"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_chapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/tc_red"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                tools:text="Lịch sử Hát Bội" />

            <TextView
                android:id="@+id/tv_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hint"
                android:textSize="12.5sp"
                tools:text="Từ nghi lễ dân gian đến sân khấu cung đình" />
        </LinearLayout>
    </LinearLayout>

    <!-- Khung ảnh trang tạp chí -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tc_space_lg"
        android:background="@drawable/hb_card_frame"
        android:padding="5dp">

        <ImageView
            android:id="@+id/iv_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Chú thích biên tập -->
    <TextView
        android:id="@+id/tv_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tc_space_md"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_secondary"
        android:textSize="13.5sp"
        tools:text="Chú thích cho trang này." />
</LinearLayout>
