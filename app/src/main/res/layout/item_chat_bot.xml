<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="bottom"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <!-- Avatar tròn của trợ lý, hiện cạnh mỗi tin nhắn bot -->
    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/tc_bg_circle_red"
        android:padding="5dp"
        android:src="@drawable/ic_tc_logo"
        app:tint="@color/white"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="272dp"
        android:background="@drawable/tc_bg_bubble_bot"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        tools:text="Với mệnh Hỏa, bạn nên chọn màu đỏ, hồng hoặc tím." />
</LinearLayout>
