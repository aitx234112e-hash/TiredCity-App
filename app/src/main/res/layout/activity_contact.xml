<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Toolbar đỏ son -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/tc_red"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        app:title="@string/title_store_locator"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="@style/TextAppearance.TiredCity.Toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <!-- ═══════════════════════════════ -->
            <!--  SECTION 1 · STORE LOCATIONS   -->
            <!-- ═══════════════════════════════ -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_pin"
                    app:tint="@color/tc_red"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="@string/title_store_locator"
                    android:textColor="@color/tc_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- ─── Store 1 card ─── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutStore1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="@dimen/tc_radius_md"
                app:cardElevation="@dimen/tc_elev_sm"
                app:cardBackgroundColor="@color/black"
                app:rippleColor="@color/tc_red_pale">

                <!-- Horizontal: image (portrait, left) + details (right) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Portrait image frame -->
                    <ImageView
                        android:id="@+id/imgStore1"
                        android:layout_width="110dp"
                        android:layout_height="190dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_store1"
                        android:contentDescription="@null" />

                    <!-- Store details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Name + map badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/store_1_name"
                                android:textColor="@color/tc_on_dark"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>

                        <!-- Map badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="10dp">
                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:src="@drawable/ic_pin"
                                app:tint="@color/tc_red"
                                android:contentDescription="@null" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Xem bản đồ"
                                android:textColor="@color/tc_red"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="@color/tc_on_dark_divider"
                            android:layout_marginBottom="10dp" />

                        <!-- Address -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="top"
                            android:layout_marginBottom="7dp">
                            <ImageView android:layout_width="13dp" android:layout_height="13dp"
                                android:layout_marginTop="2dp"
                                android:src="@drawable/ic_pin" app:tint="@color/tc_red"
                                android:contentDescription="@null" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginStart="6dp"
                                android:text="37 P. Hàng Hành, Hoàn Kiếm, Hà Nội"
                                android:textColor="@color/tc_on_dark_secondary" android:textSize="12sp"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>

                        <!-- Hours -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="7dp">
                            <ImageView android:layout_width="13dp" android:layout_height="13dp"
                                android:src="@drawable/ic_calendar" app:tint="@color/tc_red"
                                android:contentDescription="@null" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginStart="6dp"
                                android:text="9:00 – 22:30 (T2 – CN)"
                                android:textColor="@color/tc_on_dark_secondary" android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Phone -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="13dp" android:layout_height="13dp"
                                android:src="@drawable/ic_phone" app:tint="@color/tc_red"
                                android:contentDescription="@null" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginStart="6dp"
                                android:text="024 6296 0306"
                                android:textColor="@color/tc_on_dark_secondary" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── Store 2 card ─── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutStore2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="@dimen/tc_radius_md"
                app:cardElevation="@dimen/tc_elev_sm"
                app:cardBackgroundColor="@color/black"
                app:rippleColor="@color/tc_red_pale">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Portrait image frame -->
                    <ImageView
                        android:id="@+id/imgStore2"
                        android:layout_width="110dp"
                        android:layout_height="190dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_store2"
                        android:contentDescription="@null" />

                    <!-- Store details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/store_2_name"
                                android:textColor="@color/tc_on_dark"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="10dp">
                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:src="@drawable/ic_pin"
                                app:tint="@color/tc_red"
                                android:contentDescription="@null" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Xem bản đồ"
                                android:textColor="@color/tc_red"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="@color/tc_on_dark_divider"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="top"
                            android:layout_marginBottom="7dp">
                            <ImageView android:layout_width="13dp" android:layout_height="13dp"
                                android:layout_marginTop="2dp"
                                android:src="@drawable/ic_pin" app:tint="@color/tc_red"
                                android:contentDescription="@null" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginStart="6dp"
                                android:text="97 P. Hàng Gai, Hoàn Kiếm, Hà Nội"
                                android:textColor="@color/tc_on_dark_secondary" android:textSize="12sp"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="7dp">
                            <ImageView android:layout_width="13dp" android:layout_height="13dp"
                                android:src="@drawable/ic_calendar" app:tint="@color/tc_red"
                                android:contentDescription="@null" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginStart="6dp"
                                android:text="9:00 – 22:30 (T2 – CN)"
                                android:textColor="@color/tc_on_dark_secondary" android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="13dp" android:layout_height="13dp"
                                android:src="@drawable/ic_phone" app:tint="@color/tc_red"
                                android:contentDescription="@null" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginStart="6dp"
                                android:text="024 6296 0306"
                                android:textColor="@color/tc_on_dark_secondary" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════ -->
            <!--  SECTION 2 · CONTACT FORM      -->
            <!-- ═══════════════════════════════ -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/tc_red"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="@string/contact_customer_care"
                    android:textColor="@color/tc_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="@dimen/tc_radius_md"
                app:cardElevation="@dimen/tc_elev_sm"
                app:cardBackgroundColor="@color/bg_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_title"
                        android:textColor="@color/tc_red"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/contact_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="18dp" />

                    <!-- Full Name — icon: người -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_name"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/tc_stroke"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/tc_red"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/tc_red">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Phone — icon: điện thoại -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_phone_contact"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/tc_stroke"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/tc_red"
                        app:startIconDrawable="@drawable/ic_phone"
                        app:startIconTint="@color/tc_red">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email — icon: phong bì -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_email"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/tc_stroke"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/tc_red"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/tc_red">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Message — icon + label share one row above the box (multi-line box means a
                         start icon centered against the whole field would float far from the text) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_chat"
                            app:tint="@color/tc_red"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/hint_message_long"
                            android:textColor="@color/tc_red"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/tc_stroke"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintEnabled="false">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="3"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Send button -->
                    <LinearLayout
                        android:id="@+id/btnSendMessage"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/tc_btn_red_md">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chat"
                            app:tint="@color/white"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_send_message"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.05" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
