<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tc_red">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="72dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_product_images"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                    android:id="@+id/dots_images"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    app:dotsColor="@color/tc_on_red_secondary"
                    app:selectedDotColor="@color/white" />

                <!-- Back button -->
                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/tc_bg_circle_white"
                    android:src="@drawable/ic_back"
                    app:tint="@color/tc_espresso"
                    android:scaleType="centerInside"
                    android:padding="9dp"
                    android:contentDescription="@string/nav_back" />
            </FrameLayout>

            <!-- Product info card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:id="@+id/ll_card_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Name + price row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tv_product_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:lineSpacingExtra="2dp" />

                        <com.tiredcity.app.ui.widget.FavoriteButton
                            android:id="@+id/ib_save"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/btn_save" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tc_red"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp" />

                    <!-- Rating + reviews -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <RatingBar
                            android:id="@+id/rb_rating"
                            style="@style/Widget.AppCompat.RatingBar.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:progressTint="@color/tc_gold" />

                        <TextView
                            android:id="@+id/tv_rating_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_availability"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            tools:text="Còn hàng"
                            tools:background="@color/tc_bg_subtle" />
                    </LinearLayout>

                    <!-- Colour -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_colour"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/ll_colors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp" />

                    <!-- Size -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_size"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:id="@+id/tv_size_s"
                            android:layout_width="48dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/tc_bg_variant"
                            android:gravity="center"
                            android:text="@string/size_label_s"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_size_m"
                            android:layout_width="48dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/tc_bg_variant"
                            android:gravity="center"
                            android:text="@string/size_label_m"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_size_l"
                            android:layout_width="48dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/tc_bg_variant"
                            android:gravity="center"
                            android:text="@string/size_label_l"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_size_xl"
                            android:layout_width="48dp"
                            android:layout_height="40dp"
                            android:background="@drawable/tc_bg_variant"
                            android:gravity="center"
                            android:text="@string/size_label_xl"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Quantity -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_quantity"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/tc_bg_qty"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:id="@+id/btn_qty_minus"
                            android:layout_width="44dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="−"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:background="?attr/selectableItemBackgroundBorderless" />

                        <TextView
                            android:id="@+id/tv_quantity"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_qty_plus"
                            android:layout_width="44dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>

                    <!-- ── Description accordion ── -->
                    <LinearLayout
                        android:id="@+id/header_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="14dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_description"
                            android:textColor="@color/tc_red"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <ImageView
                            android:id="@+id/iv_expand_description"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/tc_red"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_description"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/tc_divider" />

                    <LinearLayout
                        android:id="@+id/content_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp" />
                    </LinearLayout>

                    <!-- ── Câu chuyện / cảm hứng thiết kế accordion ── -->
                    <LinearLayout
                        android:id="@+id/header_story"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="14dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_story"
                            android:textColor="@color/tc_red"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <ImageView
                            android:id="@+id/iv_expand_story"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/tc_red"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_story"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/tc_divider" />

                    <LinearLayout
                        android:id="@+id/content_story"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_story"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp" />
                    </LinearLayout>

                    <!-- ── Details accordion ── -->
                    <LinearLayout
                        android:id="@+id/header_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="14dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_details"
                            android:textColor="@color/tc_red"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <ImageView
                            android:id="@+id/iv_expand_details"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/tc_red"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_details"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/tc_divider" />

                    <LinearLayout
                        android:id="@+id/content_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">
                            <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                                android:text="@string/label_material" android:textColor="@color/text_secondary" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_material"
                                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">
                            <TextView android:layout_width="100dp" android:layout_height="wrap_content"
                                android:text="@string/label_origin" android:textColor="@color/text_secondary" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_origin"
                                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_specifications"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- ── Size guide accordion ── -->
                    <LinearLayout
                        android:id="@+id/header_size_guide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="14dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_size_guide"
                            android:textColor="@color/tc_red"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <ImageView
                            android:id="@+id/iv_expand_size_guide"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/tc_red"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:id="@+id/divider_size_guide"
                        android:layout_height="1dp"
                        android:background="@color/tc_divider" />

                    <LinearLayout
                        android:id="@+id/content_size_guide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/size_guide_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp" />
                    </LinearLayout>

                    <!-- ── Hướng dẫn bảo quản accordion ── -->
                    <LinearLayout
                        android:id="@+id/header_care"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="14dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_care"
                            android:textColor="@color/tc_red"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <ImageView
                            android:id="@+id/iv_expand_care"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/tc_red"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider_care"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/tc_divider" />

                    <LinearLayout
                        android:id="@+id/content_care"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:visibility="gone" />

                    <!-- ── Reviews summary ── -->
                    <TextView
                        android:id="@+id/tv_reviews_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tc_red"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="20dp"
                        tools:text="Đánh giá khách hàng (128)" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/tc_bg_underline_accent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginEnd="20dp">

                            <TextView
                                android:id="@+id/tv_avg_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                tools:text="4.5" />

                            <RatingBar
                                android:id="@+id/rb_summary_rating"
                                style="@style/Widget.AppCompat.RatingBar.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:isIndicator="true"
                                android:numStars="5"
                                android:progressTint="@color/tc_gold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <include layout="@layout/item_rating_bar_row" android:id="@+id/row_star_5" />
                            <include layout="@layout/item_rating_bar_row" android:id="@+id/row_star_4" />
                            <include layout="@layout/item_rating_bar_row" android:id="@+id/row_star_3" />
                            <include layout="@layout/item_rating_bar_row" android:id="@+id/row_star_2" />
                            <include layout="@layout/item_rating_bar_row" android:id="@+id/row_star_1" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_view_all_reviews"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="@string/btn_view_all_reviews"
                        android:textColor="@color/tc_red"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03"
                        android:background="@drawable/tc_btn_ghost_red"
                        android:layout_marginBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_reviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                    <!-- ── You may also like ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_you_may_also_like"
                        android:textColor="@color/tc_red"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="24dp" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/tc_bg_underline_accent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_related"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipToPadding="false"
                        android:paddingHorizontal="4dp"
                        android:nestedScrollingEnabled="false"
                        android:layout_marginHorizontal="-8dp"
                        android:layout_marginBottom="8dp"
                        tools:listitem="@layout/item_product" />

                    <!-- ── Cam kết dịch vụ — tối giản: viền mảnh + icon trong khung tròn nhạt, không dùng khối màu đặc ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_service_commitments"
                        android:textColor="@color/tc_red"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="24dp" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/tc_bg_underline_accent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Miễn phí vận chuyển -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/row_shipping"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/tc_stroke"
                            app:rippleColor="@color/tc_ripple_red_subtle"
                            app:cardBackgroundColor="@color/tc_bg_card">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="14dp">

                                <FrameLayout
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/tc_bg_circle_red_pale">

                                    <ImageView
                                        android:id="@+id/iv_shipping_icon"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        app:tint="@color/tc_red"
                                        tools:src="@drawable/ic_policy_shipping"
                                        android:contentDescription="@null" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/tv_shipping_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textColor="@color/text_primary"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center"
                                    android:lineSpacingExtra="1dp"
                                    android:minLines="2"
                                    tools:text="Miễn phí vận chuyển" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Đổi trả 14 ngày -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/row_returns"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/tc_stroke"
                            app:rippleColor="@color/tc_ripple_red_subtle"
                            app:cardBackgroundColor="@color/tc_bg_card">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="14dp">

                                <FrameLayout
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/tc_bg_circle_cream">

                                    <ImageView
                                        android:id="@+id/iv_returns_icon"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        app:tint="@color/tc_espresso"
                                        tools:src="@drawable/ic_policy_return"
                                        android:contentDescription="@null" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/tv_returns_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textColor="@color/text_primary"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center"
                                    android:lineSpacingExtra="1dp"
                                    android:minLines="2"
                                    tools:text="Đổi trả 14 ngày" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Thanh toán an toàn -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/row_payment"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/tc_stroke"
                            app:rippleColor="@color/tc_ripple_red_subtle"
                            app:cardBackgroundColor="@color/tc_bg_card">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="14dp">

                                <FrameLayout
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/tc_bg_circle_red_pale">

                                    <ImageView
                                        android:id="@+id/iv_payment_icon"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        app:tint="@color/tc_red"
                                        tools:src="@drawable/ic_policy_payment"
                                        android:contentDescription="@null" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/tv_payment_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textColor="@color/text_primary"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center"
                                    android:lineSpacingExtra="1dp"
                                    android:minLines="2"
                                    tools:text="Thanh toán an toàn" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom bar: Add to cart -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_add_to_cart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/tc_btn_ghost_red"
            android:text="@string/btn_add_to_cart"
            android:textColor="@color/tc_red"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/btn_buy_now"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/tc_btn_red_pill"
            android:text="@string/btn_buy_now"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium"
            android:elevation="2dp" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>