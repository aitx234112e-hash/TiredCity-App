<?xml version="1.0" encoding="utf-8"?>
<!-- 1 thẻ voucher: icon vé + tiêu đề + điều kiện (cam) + ô tích chọn bên phải. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/voucher_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_voucher_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_ticket"
        android:tint="@color/tc_gold"
        android:contentDescription="@string/pay_voucher_label" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginHorizontal="12dp">

        <TextView
            android:id="@+id/tv_voucher_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Giảm 10% (tối đa 100K)" />

        <TextView
            android:id="@+id/tv_voucher_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/tc_voucher_note"
            android:textStyle="italic"
            android:textSize="13sp"
            tools:text="Áp dụng cho toàn bộ đơn hàng" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/cb_voucher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:buttonTint="@color/tc_red" />
</LinearLayout>
