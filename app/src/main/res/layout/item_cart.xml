<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/tc_stroke"
    app:cardBackgroundColor="@color/bg_surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Select checkbox -->
        <CheckBox
            android:id="@+id/cb_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:checked="true"
            android:button="@drawable/cb_cart_button"
            app:buttonTint="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_product_image"
            app:layout_constraintBottom_toBottomOf="@id/iv_product_image" />

        <!-- Product image (portrait, larger) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_product_image"
            android:layout_width="80dp"
            android:layout_height="104dp"
            android:layout_marginStart="4dp"
            android:scaleType="centerCrop"
            android:background="@color/bg_subtle"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.TC.Medium"
            app:layout_constraintStart_toEndOf="@id/cb_select"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Delete (trash) button -->
        <ImageButton
            android:id="@+id/btn_remove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete_outline"
            android:padding="5dp"
            android:contentDescription="@string/cart_remove_item"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Product name -->
        <TextView
            android:id="@+id/tv_product_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintStart_toEndOf="@id/iv_product_image"
            app:layout_constraintEnd_toStartOf="@id/btn_remove"
            app:layout_constraintTop_toTopOf="@id/iv_product_image" />

        <!-- Variant (size/color) shown as a soft pill -->
        <LinearLayout
            android:id="@+id/ll_variant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_variant_pill"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@id/tv_product_name"
            app:layout_constraintTop_toBottomOf="@id/tv_product_name">

            <TextView
                android:id="@+id/tv_product_variant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tc_text_tertiary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/iv_variant_chevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/tc_text_tertiary"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Subtotal price -->
        <TextView
            android:id="@+id/tv_subtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tc_red"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@id/tv_product_name"
            app:layout_constraintTop_toBottomOf="@id/ll_variant" />

        <!-- Quantity stepper (bordered, minimal) -->
        <LinearLayout
            android:id="@+id/qty_stepper"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_qty_stepper_outline"
            android:clipToOutline="true"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="@id/tv_product_name"
            app:layout_constraintTop_toBottomOf="@id/tv_subtotal">

            <TextView
                android:id="@+id/btn_decrease"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/tc_red"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="8dp"
                android:background="@color/tc_stroke" />

            <TextView
                android:id="@+id/tv_quantity"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="8dp"
                android:background="@color/tc_stroke" />

            <TextView
                android:id="@+id/btn_increase"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/tc_red"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stock status (same row as stepper, right side) -->
        <TextView
            android:id="@+id/tv_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/qty_stepper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintTop_toTopOf="@id/qty_stepper"
            app:layout_constraintBottom_toBottomOf="@id/qty_stepper" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
