<?xml version="1.0" encoding="utf-8"?>
<!--
  Một dòng sản phẩm trong giỏ hàng. Không còn thẻ riêng: mọi dòng nằm chung trong
  MaterialCardView bo góc lớn của activity_cart, ngăn nhau bằng vạch mảnh (v_divider).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingStart="14dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp">

    <!-- Ô chọn — nền đỏ son, dấu tích trắng -->
    <CheckBox
        android:id="@+id/cb_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:checked="true"
        android:button="@drawable/cb_cart_button"
        app:buttonTint="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_product_image"
        app:layout_constraintBottom_toBottomOf="@id/iv_product_image" />

    <!-- Ảnh sản phẩm — bo góc tròn lớn -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_product_image"
        android:layout_width="80dp"
        android:layout_height="104dp"
        android:layout_marginStart="10dp"
        android:scaleType="centerCrop"
        android:background="@color/bg_subtle"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.TC.Large"
        app:layout_constraintStart_toEndOf="@id/cb_select"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nút xóa — chỉ hiện khi bật chế độ "Sửa" trên header -->
    <ImageButton
        android:id="@+id/btn_remove"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_delete_outline"
        android:padding="5dp"
        android:visibility="gone"
        android:contentDescription="@string/cart_remove_item"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tên sản phẩm -->
    <TextView
        android:id="@+id/tv_product_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintStart_toEndOf="@id/iv_product_image"
        app:layout_constraintEnd_toStartOf="@id/btn_remove"
        app:layout_constraintTop_toTopOf="@id/iv_product_image" />

    <!-- Phân loại (size / màu) dạng pill có chevron -->
    <LinearLayout
        android:id="@+id/ll_variant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_variant_pill"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/tv_product_name"
        app:layout_constraintTop_toBottomOf="@id/tv_product_name">

        <TextView
            android:id="@+id/tv_product_variant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="120dp"
            android:textColor="@color/tc_text_tertiary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/iv_variant_chevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/tc_text_tertiary"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Tồn kho — nằm cạnh pill phân loại -->
    <TextView
        android:id="@+id/tv_stock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/ll_variant"
        app:layout_constraintTop_toTopOf="@id/ll_variant"
        app:layout_constraintBottom_toBottomOf="@id/ll_variant" />

    <!-- Giá — trái; bộ chỉnh số lượng — phải, cùng một hàng.
         Giá dài (nhiều sản phẩm × giá cao) tự co chữ thay vì bị cắt "…". -->
    <TextView
        android:id="@+id/tv_subtotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/tc_red"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:gravity="start|center_vertical"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeMaxTextSize="19sp"
        app:autoSizeStepGranularity="1sp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="@id/tv_product_name"
        app:layout_constraintEnd_toStartOf="@id/qty_stepper"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/ll_variant" />

    <LinearLayout
        android:id="@+id/qty_stepper"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_qty_stepper_outline"
        android:clipToOutline="true"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_subtotal"
        app:layout_constraintBottom_toBottomOf="@id/tv_subtotal">

        <TextView
            android:id="@+id/btn_decrease"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/tc_red"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="8dp"
            android:background="@color/tc_cart_card_stroke" />

        <TextView
            android:id="@+id/tv_quantity"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="8dp"
            android:background="@color/tc_cart_card_stroke" />

        <TextView
            android:id="@+id/btn_increase"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/tc_red"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Đáy dòng = phần thấp nhất giữa ảnh và bộ chỉnh số lượng -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_row_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_product_image,qty_stepper" />

    <!-- Vạch ngăn với dòng kế tiếp (ẩn ở dòng cuối) -->
    <View
        android:id="@+id/v_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="46dp"
        android:background="@color/tc_cart_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier_row_bottom"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
