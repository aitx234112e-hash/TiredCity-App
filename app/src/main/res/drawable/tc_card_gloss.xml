<?xml version="1.0" encoding="utf-8"?>
<!-- Hiệu ứng "tráng gương" tĩnh: vệt sáng chéo từ góc trên-trái, mờ dần về giữa thẻ.
     Đặt ngay trên ảnh (dưới lớp scrim) để thẻ sản phẩm trông như phủ men bóng. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#38FFFFFF"
        android:centerColor="#0AFFFFFF"
        android:centerX="0.45"
        android:endColor="#00FFFFFF" />
</shape>
