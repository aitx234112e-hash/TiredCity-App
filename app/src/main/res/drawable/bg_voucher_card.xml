<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ voucher trong bottom sheet: đang chọn → nền trắng + viền đỏ; chưa chọn → nền xám nhạt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/tc_red" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tc_voucher_card_bg" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/tc_voucher_card_bg" />
        </shape>
    </item>
</selector>
