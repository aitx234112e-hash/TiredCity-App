<?xml version="1.0" encoding="utf-8"?>
<!-- Nền 1 lựa chọn thanh toán: viền đỏ son khi đang chọn (state_selected), viền nhạt khi chưa. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tc_red_pale" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/tc_red" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/bg_subtle" />
        </shape>
    </item>
</selector>
