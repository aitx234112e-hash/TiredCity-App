<?xml version="1.0" encoding="utf-8"?>
<!-- Ô nhập: viền đỏ khi focus, viền linen khi thường -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_input_field_focused" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tc_bg_card" />
            <stroke
                android:width="@dimen/tc_stroke_w"
                android:color="@color/tc_input_stroke" />
            <corners android:radius="@dimen/tc_radius_sm" />
        </shape>
    </item>
</selector>
