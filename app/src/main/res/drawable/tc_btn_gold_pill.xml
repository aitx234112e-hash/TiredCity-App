<?xml version="1.0" encoding="utf-8"?>
<!-- Nút vàng kim ánh kim + ripple đỏ khi chạm -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/tc_gold_ripple">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/tc_gold_sheen_top"
                android:centerColor="@color/tc_gold_sheen_mid"
                android:endColor="@color/tc_gold_sheen_bot" />
            <corners android:radius="@dimen/tc_radius_xl" />
        </shape>
    </item>
</ripple>
