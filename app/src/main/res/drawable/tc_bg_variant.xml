<?xml version="1.0" encoding="utf-8"?>
<!-- Chip variant (size/kích cỡ) chưa chọn: viền hồng nhạt + chữ đỏ, ripple đỏ khi chạm -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/tc_ripple_red_subtle">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tc_bg_card" />
            <stroke android:width="@dimen/tc_stroke_w" android:color="@color/tc_red_pale" />
            <corners android:radius="@dimen/tc_radius_sm" />
        </shape>
    </item>
</ripple>
