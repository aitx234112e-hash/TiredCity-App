<?xml version="1.0" encoding="utf-8"?>
<!-- Nền dạng "viên thuốc" cho tab đang chọn ở TabLayout Danh mục — thay cho gạch chân mặc định,
     tạo cảm giác segmented-control hiện đại hơn. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tc_red" />
            <corners android:radius="@dimen/tc_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
