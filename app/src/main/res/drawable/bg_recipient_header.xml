<?xml version="1.0" encoding="utf-8"?>
<!-- Dải tiêu đề đỏ sơn mài cho hộp thoại nhận hàng: bo 2 góc trên 24dp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/tc_red_lacquer_top"
        android:centerColor="@color/tc_red_lacquer_mid"
        android:endColor="@color/tc_red_lacquer_bot" />
    <corners
        android:topLeftRadius="@dimen/tc_radius_xl"
        android:topRightRadius="@dimen/tc_radius_xl"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
