<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      ╔══════════════════════════════════════════════════════════════════╗
      ║  TIREDCITY TYPOGRAPHY — 1 family duy nhất: sans-serif              ║
      ║  Variants: black (logo) / medium (heading, label) / regular (body) ║
      ║  KHÔNG dùng serif hay italic ở bất kỳ chỗ nào.                     ║
      ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- ─── Body styles (regular, dễ đọc) ───────────────────────────── -->
    <style name="TextAppearance.TC.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/tc_text_body</item>
        <item name="android:textColor">@color/tc_text_primary</item>
    </style>

    <style name="TextAppearance.TC.BodyMedium" parent="TextAppearance.TC.Body">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.TC.BodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/tc_text_caption</item>
        <item name="android:textColor">@color/tc_text_secondary</item>
    </style>

    <!-- Legacy alias names cho code cũ -->
    <style name="TextAppearance.TC.Thin" parent="TextAppearance.TC.Body" />
    <style name="TextAppearance.TC.Light" parent="TextAppearance.TC.BodySmall" />
    <style name="TextAppearance.TC.Regular" parent="TextAppearance.TC.Body" />

    <!-- ─── Headers (sans-serif bold, đồng nhất toàn app) ──────────── -->
    <style name="TextAppearance.TC.Header" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/tc_text_h1</item>
        <item name="android:textColor">@color/tc_text_primary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.TC.SectionHeader" parent="TextAppearance.TC.Header">
        <item name="android:textSize">@dimen/tc_text_h3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.TC.Editorial" parent="TextAppearance.TC.Header">
        <item name="android:textSize">@dimen/tc_text_h4</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>

    <!-- ─── Labels (uppercase wide-spaced, đậm) ─────────────────────── -->
    <style name="TextAppearance.TC.Label" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/tc_text_tiny</item>
        <item name="android:textColor">@color/tc_text_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.TC.SubLabel" parent="TextAppearance.TC.BodySmall">
        <item name="android:textSize">@dimen/tc_text_body</item>
        <item name="android:textColor">@color/tc_text_secondary</item>
    </style>

    <!-- Tab nhóm trang Danh mục (ÁO DÀI / NHẬT BÌNH / ÁO TẤC…): đậm, giữ in hoa từ string. -->
    <style name="TextAppearance.TC.CategoryTab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.TC.Nav" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/tc_text_tiny</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/tc_text_primary</item>
    </style>

    <style name="TextAppearance.TC.Caption" parent="TextAppearance.TC.BodySmall">
        <item name="android:textSize">@dimen/tc_text_tiny</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/tc_text_secondary</item>
    </style>

    <!-- ─── Logo TIREDCITY (đậm, đỏ, wide tracking) ────────────────── -->
    <style name="TextAppearance.TC.Logo" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/tc_logo_sm</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/tc_red</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.TC.Logo.Large">
        <item name="android:textSize">@dimen/tc_logo_lg</item>
    </style>

    <style name="TextAppearance.TC.Logo.Huge">
        <item name="android:textSize">@dimen/tc_logo_huge</item>
    </style>

    <!-- ─── Stats ───────────────────────────────────────────────────── -->
    <style name="TextAppearance.TC.Stats.Number" parent="TextAppearance.TC.Header">
        <item name="android:textSize">@dimen/tc_text_h1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tc_red</item>
    </style>

    <style name="TextAppearance.TC.Stats.Label" parent="TextAppearance.TC.Label">
        <item name="android:textSize">@dimen/tc_text_tiny</item>
        <item name="android:textColor">@color/tc_text_secondary</item>
    </style>

    <!-- ─── Product title ───────────────────────────────────────────── -->
    <style name="TextAppearance.TC.ProductTitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.TC.Price" parent="TextAppearance.TC.Body">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/tc_text_body</item>
        <item name="android:textColor">@color/tc_red</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tab trang Ưu đãi: chữ đậm, không tự in hoa lại (string đã in hoa) -->
    <style name="TextAppearance.TiredCity.RewardTab" parent="TextAppearance.AppCompat.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- ─── Legacy ──────────────────────────────────────────────────── -->
    <style name="TextAppearance.TiredCity.Toolbar" parent="TextAppearance.TC.SectionHeader">
        <item name="android:textColor">@color/tc_text_primary</item>
        <item name="android:textSize">@dimen/tc_text_lg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
      ╔══════════════════════════════════════════════════════════════════╗
      ║  SHAPE APPEARANCES                                                 ║
      ╚══════════════════════════════════════════════════════════════════╝
    -->
    <style name="ShapeAppearance.TC.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tc_radius_sm</item>
    </style>

    <style name="ShapeAppearance.TC.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tc_radius_md</item>
    </style>

    <style name="ShapeAppearance.TC.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tc_radius_lg</item>
    </style>

    <style name="ShapeAppearance.TC.Square" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tc_radius_sm</item>
    </style>

    <style name="ShapeAppearance.TC.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.TC.ProductImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tc_radius_sm</item>
    </style>

    <style name="ShapeAppearance.TC.CategoryThumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomRight">12dp</item>
    </style>

    <style name="ShapeAppearance.TC.BottomSheet" parent="">
        <item name="cornerSizeTopLeft">@dimen/tc_radius_sheet</item>
        <item name="cornerSizeTopRight">@dimen/tc_radius_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!--
      ╔══════════════════════════════════════════════════════════════════╗
      ║  WIDGET STYLES — Primary = đỏ son TiredCity                        ║
      ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- Primary button: đỏ son, chữ trắng đậm -->
    <style name="Widget.TC.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/tc_red</item>
        <item name="android:textColor">@color/tc_text_on_red</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textSize">@dimen/tc_text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/tc_button_height</item>
        <item name="cornerRadius">@dimen/tc_radius_xl</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Dark espresso button (alternative) -->
    <style name="Widget.TC.Button.Dark" parent="Widget.TC.Button.Primary">
        <item name="backgroundTint">@color/tc_espresso</item>
        <item name="android:textColor">@color/tc_text_on_dark</item>
    </style>

    <!-- Gold button (secondary accent) -->
    <style name="Widget.TC.Button.Gold" parent="Widget.TC.Button.Primary">
        <item name="backgroundTint">@color/tc_gold</item>
        <item name="android:textColor">@color/tc_text_on_gold</item>
    </style>

    <!-- Outlined button: thin red stroke -->
    <style name="Widget.TC.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/tc_red</item>
        <item name="strokeColor">@color/tc_red</item>
        <item name="strokeWidth">@dimen/tc_stroke_w_thick</item>
        <item name="cornerRadius">@dimen/tc_radius_xl</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textSize">@dimen/tc_text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/tc_button_height</item>
    </style>

    <!-- Text button -->
    <style name="Widget.TC.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/tc_red</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">@dimen/tc_text_tiny</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Editorial card -->
    <style name="Widget.TC.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/tc_bg_card</item>
        <item name="cardCornerRadius">@dimen/tc_radius_sm</item>
        <item name="cardElevation">@dimen/tc_elev_sm</item>
        <item name="contentPadding">@dimen/tc_space_lg</item>
    </style>

    <style name="Widget.TC.Card.Flat" parent="Widget.TC.Card">
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/tc_stroke</item>
        <item name="strokeWidth">@dimen/tc_stroke_w</item>
    </style>

    <style name="Widget.TC.Card.Dark" parent="Widget.TC.Card">
        <item name="cardBackgroundColor">@color/tc_espresso</item>
    </style>

    <style name="Widget.TC.Card.Red" parent="Widget.TC.Card">
        <item name="cardBackgroundColor">@color/tc_red</item>
    </style>

    <!-- TextInput -->
    <style name="Widget.TC.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/tc_input_stroke</item>
        <item name="boxStrokeWidth">@dimen/tc_stroke_w</item>
        <item name="hintTextColor">@color/tc_text_secondary</item>
        <item name="boxCornerRadiusTopStart">@dimen/tc_radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/tc_radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/tc_radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/tc_radius_sm</item>
    </style>

    <!-- Chip -->
    <style name="Widget.TC.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/tc_category_bg</item>
        <item name="chipStrokeColor">@color/tc_category_border</item>
        <item name="chipStrokeWidth">@dimen/tc_stroke_w</item>
        <item name="android:textColor">@color/tc_text_primary</item>
        <item name="android:textSize">@dimen/tc_text_tiny</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="chipCornerRadius">@dimen/tc_radius_pill</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.TC.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.TC.SectionHeader</item>
        <item name="titleTextColor">@color/tc_text_primary</item>
        <item name="android:background">@color/tc_bg_main</item>
    </style>

    <!-- ─── Settings: switch row + rating bar ───────────────────────── -->

    <!-- SwitchCompat: track đỏ son khi BẬT, thumb trắng. -->
    <style name="Widget.TC.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="trackTint">@color/tc_switch_track_tint</item>
        <item name="thumbTint">@color/tc_switch_thumb_tint</item>
    </style>

    <!-- RatingBar 5 sao vàng kim (dialog đánh giá).
         Dùng sao bitmap mặc định của AppCompat (tile được) rồi nhuộm vàng;
         vector tự vẽ không tile qua 5 sao nên chỉ hiện 1 sao. -->
    <style name="Widget.TC.RatingBar" parent="Widget.AppCompat.RatingBar">
        <item name="android:progressTint">@color/tc_rating_gold</item>
        <item name="android:secondaryProgressTint">@android:color/transparent</item>
        <item name="android:progressBackgroundTint">@color/tc_sand</item>
        <item name="android:numStars">5</item>
        <item name="android:stepSize">1</item>
        <item name="android:isIndicator">false</item>
    </style>

    <!-- Tiêu đề canh giữa cho toolbar các trang cài đặt. -->
    <style name="TextAppearance.TC.ToolbarCentered" parent="TextAppearance.TC.SectionHeader">
        <item name="android:textSize">@dimen/tc_text_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Dải tiêu đề nhóm (xám, nền linen nhạt). -->
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/bg_primary</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Vạch ngăn giữa các hàng cài đặt (thụt lề trái). -->
    <style name="SettingsRowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/bg_subtle</item>
        <item name="android:layout_marginStart">20dp</item>
    </style>

</resources>
