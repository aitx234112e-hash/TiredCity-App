<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      ╔══════════════════════════════════════════════════════════════════╗
      ║  THEME.TIREDCITY — Editorial Quiet Luxury                          ║
      ║  Material3 DayNight — màu nền/chữ chuyển theo values-night/colors.xml. ║
      ╚══════════════════════════════════════════════════════════════════╝
    -->
    <style name="Base.Theme.TiredCity" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- System bars -->
        <item name="android:statusBarColor">@color/tc_red</item>
        <item name="android:navigationBarColor">@color/tc_bg_main</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Material3 color roles -->
        <item name="colorPrimary">@color/tc_gold</item>
        <item name="colorOnPrimary">@color/tc_text_on_gold</item>
        <item name="colorPrimaryContainer">@color/tc_cream</item>
        <item name="colorOnPrimaryContainer">@color/tc_espresso</item>
        <item name="colorSecondary">@color/tc_espresso</item>
        <item name="colorOnSecondary">@color/tc_on_dark</item>
        <item name="colorSecondaryContainer">@color/tc_linen</item>
        <item name="colorOnSecondaryContainer">@color/tc_espresso</item>
        <item name="colorTertiary">@color/tc_sand</item>
        <item name="colorSurface">@color/tc_bg_card</item>
        <item name="colorOnSurface">@color/tc_text_primary</item>
        <item name="colorSurfaceVariant">@color/tc_bg_subtle</item>
        <item name="colorOnSurfaceVariant">@color/tc_text_secondary</item>
        <item name="colorOutline">@color/tc_stroke</item>
        <item name="android:colorBackground">@color/tc_bg_main</item>
        <!-- Nền cửa sổ kem: tránh nháy ĐEN khi chuyển Activity (Splash → Login...) -->
        <item name="android:windowBackground">@color/tc_bg_main</item>
        <item name="colorError">@color/tc_error</item>
        <item name="colorOnError">@color/colorOnError</item>

        <!-- Default typography (sans-serif regular, hết mờ) -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.TC.Header</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.TC.Header</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.TC.SectionHeader</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.TC.SectionHeader</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.TC.SectionHeader</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.TC.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.TC.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.TC.Label</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.TC.Nav</item>

        <!-- Default shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TC.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TC.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.TC.Large</item>

        <!-- Default widget styles -->
        <item name="materialButtonStyle">@style/Widget.TC.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.TC.Card</item>
        <item name="textInputStyle">@style/Widget.TC.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.TC.Chip</item>
        <item name="toolbarStyle">@style/Widget.TC.Toolbar</item>

        <!-- Bottom sheet -->
        <item name="bottomSheetDialogTheme">@style/Theme.TC.BottomSheetDialog</item>

        <!-- Hộp thoại (MaterialAlertDialog): nút chữ ĐỎ thay vì vàng (tc_gold bị chìm nền kem) -->
        <item name="materialAlertDialogTheme">@style/Theme.TC.AlertDialog</item>
    </style>

    <style name="Theme.TiredCity" parent="Base.Theme.TiredCity" />

    <!-- Launcher (LoginActivity): nền ĐỎ để cold-start hiện đỏ liền mạch với splash overlay,
         không còn nháy đen. Vẫn kế thừa đầy đủ style widget từ Base.Theme.TiredCity. -->
    <style name="Theme.TiredCity.Launcher" parent="Base.Theme.TiredCity">
        <item name="android:windowBackground">@color/tc_red</item>
    </style>

    <!--
      ╔══════════════════════════════════════════════════════════════════╗
      ║  SPLASH — espresso background, gold icon                           ║
      ╚══════════════════════════════════════════════════════════════════╝
    -->
    <style name="Theme.TiredCity.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/tc_red</item>
        <item name="android:statusBarColor">@color/tc_red</item>
        <item name="android:navigationBarColor">@color/tc_red</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/tc_red</item>
    </style>

    <!--
      ╔══════════════════════════════════════════════════════════════════╗
      ║  ALERT DIALOG — nút chữ đỏ (HỦY / ĐĂNG XUẤT...)                    ║
      ╚══════════════════════════════════════════════════════════════════╝
    -->
    <style name="Theme.TC.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.TC.AlertDialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.TC.AlertDialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.TC.AlertDialog.Button</item>
    </style>

    <style name="Widget.TC.AlertDialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/tc_red</item>
    </style>

    <!--
      ╔══════════════════════════════════════════════════════════════════╗
      ║  DATE PICKER — giữ lưới lịch Material nhưng BỎ animation mở        ║
      ╚══════════════════════════════════════════════════════════════════╝
      MaterialDatePicker mặc định phóng-to (scale) khi hiện ra; hiệu ứng này chạy CÙNG LÚC
      với việc dựng lưới lịch nặng trên main thread → giật giựt. Gán windowAnimationStyle rỗng
      để dialog bung ra TỨC THÌ, không animation → hết giật. Lưới lịch & màu sắc giữ nguyên
      (kế thừa ThemeOverlay.Material3.MaterialCalendar). Dùng qua MaterialDatePicker.Builder.setTheme().
    -->
    <style name="Animation.TC.None" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <style name="Theme.TC.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="android:windowAnimationStyle">@style/Animation.TC.None</item>

        <!-- Nền lịch TRẮNG hẳn (bỏ lớp tint kem/tím của surface mặc định). Material3 lấy nền
             hộp lịch từ colorSurfaceContainerHigh; set cả nhóm surface về trắng cho chắc. -->
        <item name="colorSurface">@android:color/white</item>
        <item name="colorSurfaceContainerHigh">@android:color/white</item>
        <item name="colorSurfaceContainer">@android:color/white</item>
        <item name="colorSurfaceContainerLow">@android:color/white</item>
        <item name="colorSurfaceContainerLowest">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>

        <!-- QUAN TRỌNG: Material tự phủ lớp "elevation overlay" (ánh màu colorPrimary/colorOnSurface)
             lên mọi surface có elevation (dialog) → nền trắng bị ánh hồng dù đã set colorSurface
             trắng ở trên. Tắt hẳn elevationOverlayEnabled để nền trắng tinh thật sự. -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Hình tròn ngày được chọn: ĐỎ (thay vì vàng), số bên trong TRẮNG cho dễ đọc.
             colorPrimary cũng nhuộm mũi tên ‹ › và nút HỦY/OK sang đỏ → đồng bộ. -->
        <item name="colorPrimary">@color/tc_red</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Chữ ngày (1, 2, 3...) & nhãn thứ (CN, T2...): cỡ vừa phải, nét MỎNG
             (không bold) cho thanh thoát — trước đây 22sp bold nên bị "bự & đậm quá". -->
        <item name="materialCalendarDay">@style/Widget.TC.DatePicker.DayTextView</item>
        <item name="materialCalendarDayOfWeekLabel">@style/Widget.TC.DatePicker.DayOfWeekLabel</item>

        <!-- Dòng tiêu đề nhỏ ("VUI LÒNG NHẬP NGÀY SINH...") mặc định quá nhỏ & mờ,
             gần như không đọc được → phóng to + màu đậm cho rõ. -->
        <item name="materialCalendarHeaderTitle">@style/Widget.TC.DatePicker.HeaderTitle</item>
    </style>

    <style name="Widget.TC.DatePicker.DayTextView" parent="Widget.Material3.MaterialCalendar.DayTextView">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.TC.DatePicker.DayOfWeekLabel" parent="Widget.Material3.MaterialCalendar.DayOfWeekLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.TC.DatePicker.HeaderTitle" parent="Widget.Material3.MaterialCalendar.HeaderTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tc_text_primary</item>
        <!-- Cho phép xuống 2 dòng để chữ to mà không bị cắt cụt "..." -->
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">none</item>
    </style>

    <!--
      ╔══════════════════════════════════════════════════════════════════╗
      ║  BOTTOM SHEET                                                      ║
      ╚══════════════════════════════════════════════════════════════════╝
    -->
    <style name="Theme.TC.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.TC.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/tc_bg_main</item>
    </style>

    <style name="Widget.TC.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TC.BottomSheet</item>
        <item name="backgroundTint">@color/tc_bg_main</item>
    </style>

    <style name="Theme.TC.TransparentBottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <!--
      ╔══════════════════════════════════════════════════════════════════╗
      ║  LEGACY — keep TextAppearance.TiredCity.Toolbar pointer            ║
      ║  (already defined in styles.xml, kept here for backward ref)       ║
      ╚══════════════════════════════════════════════════════════════════╝
    -->

</resources>
