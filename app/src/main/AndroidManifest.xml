<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Permissions ──────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ── Package visibility (API 30+): cần khai báo để getLaunchIntentForPackage()
         thấy được app Quản trị (com.tiredcity.admin) khi đã cài ── -->
    <queries>
        <package android:name="com.facebook.katana" />
        <package android:name="com.tiredcity.admin" />
    </queries>

    <application
        android:name=".TiredCityApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TiredCity"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="@string/facebook_app_id"/>
        <meta-data android:name="com.facebook.sdk.ClientToken" android:value="@string/facebook_client_token"/>

        <provider android:authorities="@string/facebook_provider_authority"
            android:name="com.facebook.FacebookContentProvider"
            android:exported="true" />

        <activity android:name="com.facebook.FacebookActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:label="@string/app_name" />
        
        <activity
            android:name="com.facebook.CustomTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/fb_login_protocol_scheme" />
            </intent-filter>
        </activity>

        <!-- ── Launcher: Login kiêm splash overlay (gộp 1 activity để hết khung đen) ── -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.TiredCity.Launcher"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Onboarding & Auth ─────────────────────────────────────────── -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── Main shell ────────────────────────────────────────────────── -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ── Shop ──────────────────────────────────────────────────────── -->
        <activity
            android:name=".ui.shop.ProductDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.shop.SearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.shop.CategoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ── Cart & Checkout ───────────────────────────────────────────── -->
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.cart.PaymentActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.cart.QrPaymentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.cart.OrderSuccessActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.cart.OrderTrackingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ── Explore: News & Events ────────────────────────────────────── -->
        <activity
            android:name=".ui.explore.ArticleActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.explore.ArticleDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.TiredCity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.explore.HatBoiMagazineActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.explore.EventActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.explore.EventDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.explore.WorkshopYeuNuocActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.explore.NewsDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ── Notifications ─────────────────────────────────────────────── -->
        <activity
            android:name=".ui.notification.NotificationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ── Profile ───────────────────────────────────────────────────── -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.profile.OrderHistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.profile.WardrobeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ── Rewards / Ưu đãi ──────────────────────────────────────────── -->
        <activity
            android:name=".ui.reward.RewardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.reward.VoucherDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.reward.BarcodeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ── Styling / AI ──────────────────────────────────────────────── -->
        <activity
            android:name=".ui.styling.AiStylingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.styling.ChatBotActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── Support ───────────────────────────────────────────────────── -->
        <activity
            android:name=".ui.support.PolicyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.support.TermsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.support.ContactActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── Settings (Cài đặt thông báo & Cài đặt chung) ──────────────── -->
        <activity
            android:name=".ui.settings.NotificationSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.settings.GeneralSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.settings.SecuritySettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.settings.PinActivity"
            android:exported="false"
            android:theme="@style/Theme.TiredCity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.settings.ChangePasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.settings.AppInfoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.settings.AccountDeletionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".service.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
