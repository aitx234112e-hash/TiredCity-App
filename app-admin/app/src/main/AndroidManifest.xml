<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+: cần khai báo để thấy & mở được app khách hàng (trang đăng nhập chung). -->
    <queries>
        <package android:name="com.tiredcity.app" />
    </queries>

    <application
        android:name=".TiredCityAdminApp"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TiredCityAdmin"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.list.ModuleListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.form.EntityFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.revenue.RevenueActivity"
            android:exported="false" />

        <activity
            android:name=".ui.reports.ReportsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.chatbot.ChatbotActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.order.AdminOrderActivity"
            android:exported="false"
            android:label="Order Management" />

        <activity
            android:name=".ui.seed.SeedDataActivity"
            android:exported="false"
            android:label="Seed Data" />

    </application>
</manifest>
