{
  "name": "TiredCity AI Agent",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "note": "Import vao n8n: Workflows -> ... -> Import from File. Sau khi import phai (1) gan credential Gemini cho node 'Google Gemini Chat Model', (2) gan credential Firestore (Service Account) cho 3 node tool HTTP, (3) Activate de lay URL webhook." },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tiredcity-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-160, 0],
      "webhookId": "tiredcity-agent-webhook"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "Bạn là trợ lý AI của TiredCity, thương hiệu thời trang/lifestyle in artwork bản quyền.\nNhiệm vụ: tư vấn sản phẩm và hỗ trợ CSKH.\n\nQUY TẮC BẮT BUỘC:\n- KHÔNG được tự bịa thông tin tồn kho, giá, trạng thái đơn hàng. Luôn gọi tool tương ứng để lấy dữ liệu thật:\n  • Hỏi về đơn hàng / trạng thái / theo dõi → gọi get_order_status.\n  • Hỏi về giá / còn hàng / tồn kho của sản phẩm → gọi get_product.\n- Nếu thiếu thông tin để gọi tool (vd: chưa có mã đơn hàng), hỏi lại khách. Mã đơn TiredCity có dạng ví dụ TC12345.\n- Nếu khách bực bội, yêu cầu gặp người thật, hoặc vấn đề vượt phạm vi (khiếu nại nghiêm trọng, hoàn tiền lớn) → gọi escalate_to_human, rồi báo khách rằng yêu cầu đã được chuyển tới nhân viên và sẽ liên hệ lại sớm.\n- Diễn giải trạng thái đơn cho khách: pending = chờ xác nhận, processing = đang chuẩn bị, shipped = đang giao, delivered = đã giao, cancelled = đã huỷ.\n- Giọng điệu: thân thiện, trẻ trung, đúng chất TiredCity. Trả lời tiếng Việt có dấu, ngắn gọn, có thể dùng emoji. Không trả về markdown thô/bảng."
        }
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [140, 0]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {}
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [40, 240]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.body.sessionId }}"
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [200, 240]
    },
    {
      "parameters": {
        "toolDescription": "Lấy trạng thái và thông tin một đơn hàng theo mã đơn (orderID, ví dụ TC12345). Dùng khi khách hỏi đơn tới đâu, khi nào giao, trạng thái đơn. Trả về JSON Firestore chứa status, createdAt, totalPrice, userName.",
        "method": "POST",
        "url": "https://firestore.googleapis.com/v1/projects/tiredcity-daf1e/databases/(default)/documents:runQuery",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"structuredQuery\":{\"from\":[{\"collectionId\":\"orders\"}],\"where\":{\"fieldFilter\":{\"field\":{\"fieldPath\":\"orderID\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"{orderId}\"}}},\"limit\":1}}",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "orderId",
              "description": "Mã đơn hàng khách cung cấp, ví dụ TC12345",
              "type": "string"
            }
          ]
        }
      },
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "get_order_status",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [360, 240]
    },
    {
      "parameters": {
        "toolDescription": "Trả về danh sách sản phẩm TiredCity (tên, giá, tồn kho stocked_quantity). Dùng khi khách hỏi giá bao nhiêu, còn hàng không, size/màu nào còn. Tự tìm sản phẩm khớp tên khách hỏi trong danh sách JSON trả về.",
        "method": "POST",
        "url": "https://firestore.googleapis.com/v1/projects/tiredcity-daf1e/databases/(default)/documents:runQuery",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"structuredQuery\":{\"from\":[{\"collectionId\":\"products\"}],\"limit\":60}}"
      },
      "id": "66666666-6666-4666-8666-666666666666",
      "name": "get_product",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [520, 240]
    },
    {
      "parameters": {
        "toolDescription": "Chuyển yêu cầu cho nhân viên thật. Gọi khi khách bực bội, đòi gặp người thật, khiếu nại nặng hoặc hoàn tiền lớn. Ghi 1 ticket vào Firestore rồi báo khách đã chuyển cho nhân viên.",
        "method": "POST",
        "url": "https://firestore.googleapis.com/v1/projects/tiredcity-daf1e/databases/(default)/documents/support_tickets",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"fields\":{\"reason\":{\"stringValue\":\"{reason}\"},\"sessionId\":{\"stringValue\":\"{sessionId}\"},\"status\":{\"stringValue\":\"open\"}}}",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "reason",
              "description": "Tóm tắt ngắn vấn đề của khách cần nhân viên xử lý",
              "type": "string"
            },
            {
              "name": "sessionId",
              "description": "Mã phiên/khách, lấy từ ngữ cảnh hội thoại",
              "type": "string"
            }
          ]
        }
      },
      "id": "77777777-7777-4777-8777-777777777777",
      "name": "escalate_to_human",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [680, 240]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"reply\": $json.output } }}",
        "options": {}
      },
      "id": "88888888-8888-4888-8888-888888888888",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 0]
    }
  ],
  "connections": {
